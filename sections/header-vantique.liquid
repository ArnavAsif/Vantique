{%- liquid
  assign logo_text = section.settings.logo_text | default: 'VANTIQUE'
  assign logo_image = section.settings.logo_image
  assign logo_width_desk = section.settings.logo_width_desktop | default: 140
  assign logo_width_mob = section.settings.logo_width_mobile | default: 110
  assign menu = linklists[section.settings.menu]
  assign color_bg = section.settings.bg_color | default: '#000000'
  assign color_text = section.settings.text_color | default: '#ffffff'
  assign color_accent = section.settings.accent_color | default: '#c6ff00'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --vh-bg: {{ color_bg }};
    --vh-text: {{ color_text }};
    --vh-accent: {{ color_accent }};
    --vh-logo-desk: {{ logo_width_desk }}px;
    --vh-logo-mob: {{ logo_width_mob }}px;
    --vh-header-height-desk: 85px;
    --vh-header-height-mob: 70px;
    --vh-easing: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── BASE HEADER ── */
  .v-header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 250;
    transition: background-color 0.5s var(--vh-easing), border-color 0.5s var(--vh-easing), backdrop-filter 0.5s var(--vh-easing);
    background-color: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    font-family: 'Inter', sans-serif;
  }

  /* Cinematic Gradient Protection */
  .v-header-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 180px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.5s var(--vh-easing);
  }

  /* Premium Scrolled State (homepage only) */
  .v-header-wrapper.is-scrolled {
    background-color: rgba(5, 5, 5, 0.65);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .v-header-wrapper.is-scrolled::before {
    opacity: 0;
  }

  /* ── NON-HOMEPAGE: ALWAYS SOLID ── */
  .v-header-wrapper:not(.is-homepage) {
    background-color: rgba(5, 5, 5, 0.95);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .v-header-wrapper:not(.is-homepage)::before {
    opacity: 0;
  }

  .v-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--vh-header-height-mob);
    padding: 0 5vw;
    max-width: 1800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1025px) {
    .v-header {
      height: var(--vh-header-height-desk);
      padding: 0 4vw;
    }
  }

  /* ── LOGO ── */
  .v-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--vh-text);
    z-index: 260;
  }
  
  .v-logo__text {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 2px 15px rgba(0,0,0,0.5);
    transition: text-shadow 0.3s ease, color 0.3s ease;
  }

  .v-logo:hover .v-logo__text {
    text-shadow: 0 0 15px rgba(255,255,255,0.4);
  }

  .v-logo__img {
    width: var(--vh-logo-mob);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
    transition: width 0.3s ease;
  }

  @media (min-width: 1025px) {
    .v-logo__img {
      width: var(--vh-logo-desk);
    }
  }

  /* ── DESKTOP NAV ── */
  .v-nav {
    display: none;
  }

  @media (min-width: 1025px) {
    .v-nav {
      display: flex;
      align-items: center;
      gap: 2.5rem;
    }
  }

  .v-nav__link {
    color: var(--vh-text);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    position: relative;
    padding: 0.5rem 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    transition: color 0.3s ease;
  }

  .v-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--vh-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--vh-easing), box-shadow 0.4s ease;
  }

  .v-nav__link:hover {
    color: var(--vh-accent);
  }

  .v-nav__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
    box-shadow: 0 0 10px var(--vh-accent);
  }

  .v-header-wrapper.is-scrolled .v-nav__link,
  .v-header-wrapper.is-scrolled .v-logo__text {
    text-shadow: none;
  }

  /* ── HEADER ICONS ── */
  .v-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    z-index: 260;
  }

  .v-icon-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    color: var(--vh-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
    transition: color 0.3s ease, transform 0.3s ease, filter 0.3s;
  }

  .v-header-wrapper.is-scrolled .v-icon-btn {
    filter: none;
  }

  .v-icon-btn:hover {
    color: var(--vh-accent);
    transform: translateY(-2px);
  }

  .v-icon-btn svg {
    width: 22px;
    height: 22px;
    stroke-width: 1.5;
  }

  .v-cart-count {
    position: absolute;
    top: 2px;
    right: 0px;
    background: var(--vh-accent);
    color: #000;
    font-size: 0.65rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(50%, -50%);
    box-shadow: 0 0 10px rgba(198, 255, 0, 0.4);
  }

  .v-mobile-toggle {
    display: block;
  }

  @media (min-width: 1025px) {
    .v-mobile-toggle { display: none; }
    .v-actions { gap: 1.5rem; }
  }

  .hide-on-mobile {
    display: none;
  }

  @media (min-width: 1025px) {
    .hide-on-mobile { display: flex; }
  }

  /* ── OVERLAYS ── */
  .v-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 300;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--vh-easing), visibility 0.5s;
  }

  .v-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* ── MOBILE MENU DRAWER ── */
  .v-mob-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 310;
    transform: translateX(-100%);
    transition: transform 0.6s var(--vh-easing);
    display: flex;
    flex-direction: column;
    padding: 6rem 2rem 3rem;
    border-right: 1px solid rgba(255,255,255,0.05);
  }

  .v-mob-menu.is-active {
    transform: translateX(0);
  }

  .v-mob-menu__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--vh-text);
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    transition: transform 0.5s var(--vh-easing), color 0.3s;
  }

  .v-mob-menu.is-active .v-mob-menu__close {
    transform: rotate(90deg);
  }

  .v-mob-menu__close:hover {
    color: var(--vh-accent);
    transform: rotate(180deg);
  }

  .v-mob-menu__close svg { width: 32px; height: 32px; }

  .v-mob-nav {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .v-mob-link {
    color: var(--vh-text);
    text-decoration: none;
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--vh-easing), transform 0.4s var(--vh-easing), color 0.3s;
  }

  .v-mob-menu.is-active .v-mob-link {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--i) * 0.08s + 0.2s);
  }

  .v-mob-link:hover {
    color: var(--vh-accent);
    text-shadow: 0 0 15px rgba(198,255,0,0.3);
  }

  /* ── CART DRAWER ── */
  .v-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 440px;
    height: 100vh;
    background: rgba(12, 12, 12, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 310;
    transform: translateX(100%);
    transition: transform 0.6s var(--vh-easing);
    display: flex;
    flex-direction: column;
    border-left: 1px solid rgba(255,255,255,0.05);
    font-family: 'Inter', sans-serif;
  }

  .v-cart-drawer.is-active {
    transform: translateX(0);
  }

  .v-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .v-cart-title {
    color: var(--vh-text);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .v-cart-close {
    background: none;
    border: none;
    color: var(--vh-text);
    cursor: pointer;
    transition: color 0.3s, transform 0.5s var(--vh-easing);
  }

  .v-cart-drawer.is-active .v-cart-close {
    transform: rotate(90deg);
  }

  .v-cart-close:hover {
    color: var(--vh-accent);
    transform: rotate(180deg);
  }

  .v-cart-close svg { width: 28px; height: 28px; }

  /* Cart Items */
  .v-cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .v-cart-items::-webkit-scrollbar { width: 4px; }
  .v-cart-items::-webkit-scrollbar-track { background: transparent; }
  .v-cart-items::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); }

  .v-cart-empty {
    text-align: center;
    color: rgba(255,255,255,0.5);
    margin-top: 2rem;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .v-cart-item {
    display: flex;
    gap: 1.25rem;
    position: relative;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .v-cart-item__img {
    width: 90px;
    height: 110px;
    object-fit: cover;
    background: #1a1a1a;
    border-radius: 4px;
  }

  .v-cart-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .v-cart-item__title {
    color: var(--vh-text);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    margin-bottom: 0.25rem;
    display: block;
  }

  .v-cart-item__title:hover {
    color: var(--vh-accent);
  }

  .v-cart-item__variant {
    color: rgba(255,255,255,0.5);
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .v-cart-item__price {
    color: var(--vh-accent);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .v-cart-item__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
  }

  .v-qty-selector {
    display: flex;
    align-items: center;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 2px;
  }

  .v-qty-btn {
    background: transparent;
    border: none;
    color: var(--vh-text);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .v-qty-btn:hover {
    background: var(--vh-accent);
    color: #000;
  }

  .v-qty-input {
    width: 30px;
    text-align: center;
    background: transparent;
    border: none;
    color: var(--vh-text);
    font-size: 0.85rem;
    font-weight: 600;
    pointer-events: none;
  }

  .v-cart-item__remove {
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .v-cart-item__remove:hover {
    color: #ff3333;
  }

  /* Cart Footer */
  .v-cart-footer {
    padding: 2rem;
    background: rgba(0,0,0,0.4);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .v-cart-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--vh-text);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .v-cart-subtotal-price {
    color: var(--vh-accent);
  }

  .v-cart-checkout {
    display: block;
    width: 100%;
    padding: 1.2rem;
    background: var(--vh-accent);
    color: #000;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.4s var(--vh-easing);
    box-shadow: 0 4px 15px rgba(198, 255, 0, 0.15);
  }

  .v-cart-checkout:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(198, 255, 0, 0.3);
    background: #e0ff4d;
  }

  /* Loader */
  .v-cart-loader {
    position: absolute;
    inset: 0;
    background: rgba(12,12,12,0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s;
  }

  .v-cart-loader.is-active {
    opacity: 1;
    visibility: visible;
  }

  .v-cart-loader-spinner {
    width: 30px;
    height: 30px;
    border: 2px solid rgba(198,255,0,0.2);
    border-top-color: var(--vh-accent);
    border-radius: 50%;
    animation: v-spin 0.8s linear infinite;
  }

  @keyframes v-spin { to { transform: rotate(360deg); } }

</style>

<!-- SVGs -->
<svg style="display:none;">
  <defs>
    <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
    </symbol>
    <symbol id="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
    </symbol>
    <symbol id="icon-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
    </symbol>
    <symbol id="icon-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
    </symbol>
    <symbol id="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"/>
    </symbol>
    <symbol id="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </symbol>
  </defs>
</svg>

<header class="v-header-wrapper{% if request.page_type == 'index' %} is-homepage{% endif %}" id="v-header">
  <div class="v-header">
    
    <!-- Mobile Hamburger -->
    <button class="v-icon-btn v-mobile-toggle js-mob-toggle" aria-label="Open Menu">
      <svg><use href="#icon-menu"></use></svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="v-logo">
      {%- if logo_image != blank -%}
        <img src="{{ logo_image | image_url: width: 600 }}" alt="{{ shop.name }}" class="v-logo__img">
      {%- else -%}
        <span class="v-logo__text">{{ logo_text }}</span>
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="v-nav">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}" class="v-nav__link">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <!-- Actions -->
    <div class="v-actions">
      <a href="{{ routes.search_url }}" class="v-icon-btn hide-on-mobile" aria-label="Search">
        <svg><use href="#icon-search"></use></svg>
      </a>
      <a href="{{ routes.account_url }}" class="v-icon-btn hide-on-mobile" aria-label="Account">
        <svg><use href="#icon-user"></use></svg>
      </a>
      <a href="#wishlist" class="v-icon-btn hide-on-mobile" aria-label="Wishlist">
        <svg><use href="#icon-heart"></use></svg>
      </a>
      <button class="v-icon-btn js-cart-toggle" aria-label="Cart">
        <svg><use href="#icon-cart"></use></svg>
        <span class="v-cart-count js-cart-count">{{ cart.item_count }}</span>
      </button>
    </div>

  </div>
</header>

<!-- Global Overlay -->
<div class="v-overlay js-overlay"></div>

<!-- Mobile Menu Drawer -->
<div class="v-mob-menu js-mob-menu">
  <button class="v-mob-menu__close js-mob-close" aria-label="Close Menu">
    <svg><use href="#icon-close"></use></svg>
  </button>
  <nav class="v-mob-nav">
    {%- for link in menu.links -%}
      <a href="{{ link.url }}" class="v-mob-link" style="--i: {{ forloop.index }};">{{ link.title }}</a>
    {%- endfor -%}
    <a href="{{ routes.account_url }}" class="v-mob-link" style="--i: {{ menu.links.size | plus: 1 }};">Account</a>
    <a href="{{ routes.search_url }}" class="v-mob-link" style="--i: {{ menu.links.size | plus: 2 }};">Search</a>
  </nav>
</div>

<!-- Cart Drawer -->
<div class="v-cart-drawer js-cart-drawer">
  
  <div class="v-cart-header">
    <h3 class="v-cart-title">Cart</h3>
    <button class="v-cart-close js-cart-close" aria-label="Close Cart">
      <svg><use href="#icon-close"></use></svg>
    </button>
  </div>

  <div class="v-cart-items js-cart-items-container">
    {%- if cart.item_count == 0 -%}
      <p class="v-cart-empty">Your cart is empty.</p>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="v-cart-item">
          <a href="{{ item.url }}">
            <img src="{{ item.image | image_url: width: 200 }}" class="v-cart-item__img" alt="{{ item.title | escape }}">
          </a>
          <div class="v-cart-item__details">
            <div>
              <a href="{{ item.url }}" class="v-cart-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="v-cart-item__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="v-cart-item__price">{{ item.final_line_price | money }}</div>
            </div>
            <div class="v-cart-item__actions">
              <div class="v-qty-selector">
                <button class="v-qty-btn js-qty-change" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}">-</button>
                <input type="text" class="v-qty-input" value="{{ item.quantity }}" readonly>
                <button class="v-qty-btn js-qty-change" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
              </div>
              <button class="v-cart-item__remove js-qty-change" data-line="{{ forloop.index }}" data-qty="0">Remove</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="v-cart-footer">
    <div class="v-cart-subtotal">
      <span>Subtotal</span>
      <span class="v-cart-subtotal-price js-cart-total">{{ cart.total_price | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="v-cart-checkout js-cart-checkout">Proceed to Checkout</a>
  </div>

  <div class="v-cart-loader js-cart-loader">
    <div class="v-cart-loader-spinner"></div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  // ── SCROLL HEADER LOGIC ──
  const header = document.getElementById('v-header');
  const scrollThreshold = 30;
  const isHomepage = header.classList.contains('is-homepage');

  window.addEventListener('scroll', () => {
    if (!isHomepage) return;
    if (window.scrollY > scrollThreshold) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  });

  // ── FIX CONTENT HIDDEN UNDER HEADER ON NON-HOMEPAGE ──
  if (!isHomepage) {
    const mainContent = document.querySelector('main, #MainContent, .main-content, [role="main"]');
    if (mainContent) {
      const setOffset = () => {
        const h = window.innerWidth >= 1025 ? 85 : 70;
        mainContent.style.paddingTop = h + 'px';
      };
      setOffset();
      window.addEventListener('resize', setOffset);
    }
  }

  // ── MENU & CART DRAWER TOGGLES ──
  const overlay = document.querySelector('.js-overlay');
  const mobMenu = document.querySelector('.js-mob-menu');
  const cartDrawer = document.querySelector('.js-cart-drawer');

  document.querySelector('.js-mob-toggle')?.addEventListener('click', () => {
    overlay.classList.add('is-active');
    mobMenu.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  });

  document.querySelector('.js-mob-close')?.addEventListener('click', closeAllDrawers);

  document.querySelectorAll('.js-cart-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      overlay.classList.add('is-active');
      cartDrawer.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    });
  });

  document.querySelector('.js-cart-close')?.addEventListener('click', closeAllDrawers);
  overlay?.addEventListener('click', closeAllDrawers);

  function closeAllDrawers() {
    overlay.classList.remove('is-active');
    mobMenu.classList.remove('is-active');
    cartDrawer.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  // ── AJAX CART LOGIC ──
  const cartItemsContainer = document.querySelector('.js-cart-items-container');
  const cartCountEls = document.querySelectorAll('.js-cart-count');
  const cartTotalEl = document.querySelector('.js-cart-total');
  const cartLoader = document.querySelector('.js-cart-loader');

  const formatMoney = (cents, format = '${{amount}}') => {
    if (typeof cents == 'string') cents = cents.replace('.', '');
    let value = '';
    const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
    const formatString = format || '${{amount}}';
    
    function defaultOption(opt, def) { return (typeof opt == 'undefined' ? def : opt); }
    function formatWithDelimiters(number, precision, thousands, decimal) {
      precision = defaultOption(precision, 2);
      thousands = defaultOption(thousands, ',');
      decimal   = defaultOption(decimal, '.');
      if (isNaN(number) || number == null) return 0;
      number = (number / 100.0).toFixed(precision);
      let parts = number.split('.'),
          dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
          cents   = parts[1] ? (decimal + parts[1]) : '';
      return dollars + cents;
    }

    switch(formatString.match(placeholderRegex)[1]) {
      case 'amount': value = formatWithDelimiters(cents, 2); break;
      case 'amount_no_decimals': value = formatWithDelimiters(cents, 0); break;
      case 'amount_with_comma_separator': value = formatWithDelimiters(cents, 2, '.', ','); break;
      case 'amount_no_decimals_with_comma_separator': value = formatWithDelimiters(cents, 0, '.', ','); break;
    }
    return formatString.replace(placeholderRegex, value);
  };

  const renderCartItems = (cart) => {
    cartCountEls.forEach(el => el.textContent = cart.item_count);
    cartTotalEl.textContent = formatMoney(cart.total_price);

    if (cart.item_count === 0) {
      cartItemsContainer.innerHTML = '<p class="v-cart-empty">Your cart is empty.</p>';
      return;
    }

    let html = '';
    cart.items.forEach((item, index) => {
      let variantHtml = item.variant_title ? `<div class="v-cart-item__variant">${item.variant_title}</div>` : '';
      html += `
        <div class="v-cart-item">
          <a href="${item.url}">
            <img src="${item.image || ''}" class="v-cart-item__img" alt="${item.product_title}">
          </a>
          <div class="v-cart-item__details">
            <div>
              <a href="${item.url}" class="v-cart-item__title">${item.product_title}</a>
              ${variantHtml}
              <div class="v-cart-item__price">${formatMoney(item.final_line_price)}</div>
            </div>
            <div class="v-cart-item__actions">
              <div class="v-qty-selector">
                <button class="v-qty-btn js-qty-change" data-line="${index + 1}" data-qty="${item.quantity - 1}">-</button>
                <input type="text" class="v-qty-input" value="${item.quantity}" readonly>
                <button class="v-qty-btn js-qty-change" data-line="${index + 1}" data-qty="${item.quantity + 1}">+</button>
              </div>
              <button class="v-cart-item__remove js-qty-change" data-line="${index + 1}" data-qty="0">Remove</button>
            </div>
          </div>
        </div>
      `;
    });
    
    cartItemsContainer.innerHTML = html;
    attachCartEvents();
  };

  const updateCartItem = (line, quantity) => {
    cartLoader.classList.add('is-active');
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ line: line, quantity: quantity })
    })
    .then(response => response.json())
    .then(cart => {
      renderCartItems(cart);
      cartLoader.classList.remove('is-active');
    })
    .catch(error => {
      console.error('Error updating cart:', error);
      cartLoader.classList.remove('is-active');
    });
  };

  const attachCartEvents = () => {
    document.querySelectorAll('.js-qty-change').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const line = e.currentTarget.getAttribute('data-line');
        const qty = e.currentTarget.getAttribute('data-qty');
        updateCartItem(line, qty);
      });
    });
  };

  attachCartEvents();
});
</script>

