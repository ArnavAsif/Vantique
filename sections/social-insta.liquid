{%- liquid
  assign top_label   = section.settings.top_label
  assign heading     = section.settings.heading
  assign subheading  = section.settings.subheading
  assign ig_handle   = section.settings.ig_handle
  assign cta_text    = section.settings.cta_text
  assign cta_link    = section.settings.cta_link
  
  assign bg_base     = section.settings.bg_base
  assign neon_hex    = section.settings.neon_color
  assign neon_rgb    = section.settings.neon_rgb
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --vs-base: {{ bg_base }};
    --vs-neon: {{ neon_hex }};
    --vs-neon-rgb: {{ neon_rgb }};
    --vs-text: #ffffff;
    --vs-glass: rgba(255, 255, 255, 0.03);
    --vs-glass-border: rgba(255, 255, 255, 0.08);
  }

  .vantique-social * {
    box-sizing: border-box;
  }

  .vantique-social {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--vs-base);
    color: var(--vs-text);
    padding-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(5rem, 12vw, 8rem);
    font-family: 'Inter', system-ui, sans-serif;
    isolation: isolate;
  }

  /* ==========================================================
     CINEMATIC BACKGROUND (IMPORTED FROM VERDE & ADAPTED)
     ========================================================== */
  .vs__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Dark Matte Base */
  .vs__bg-base {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #020202 0%, #0a0a0a 40%, #050505 100%);
  }

  /* Neon Glowing Orbs */
  .vs__bg-glow-l {
    position: absolute;
    inset: -10%;
    background: radial-gradient(ellipse 50% 70% at 10% 60%, rgba(var(--vs-neon-rgb), 0.15) 0%, rgba(var(--vs-neon-rgb), 0.05) 50%, transparent 70%);
    filter: blur(70px);
  }

  .vs__bg-glow-c {
    position: absolute;
    inset: -10%;
    background: radial-gradient(ellipse 60% 60% at 50% 40%, rgba(255, 255, 255, 0.05) 0%, rgba(var(--vs-neon-rgb), 0.08) 45%, transparent 75%);
    filter: blur(80px);
  }

  .vs__bg-glow-r {
    position: absolute;
    inset: -10%;
    background: radial-gradient(ellipse 45% 55% at 90% 30%, rgba(255, 255, 255, 0.08) 0%, rgba(var(--vs-neon-rgb), 0.12) 50%, transparent 70%);
    filter: blur(70px);
  }

  .vs__bg-glow-spot {
    position: absolute;
    top: 50%;
    left: 55%;
    transform: translate(-50%, -52%);
    width: 65%;
    height: 85%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.1) 0%, rgba(var(--vs-neon-rgb), 0.05) 40%, transparent 75%);
    mix-blend-mode: screen;
    filter: blur(60px);
    animation: vs-spot-pulse 6s ease-in-out infinite alternate;
  }

  @keyframes vs-spot-pulse {
    0%   { opacity: 0.5; transform: translate(-50%, -52%) scale(0.95); }
    100% { opacity: 1.0; transform: translate(-50%, -52%) scale(1.1); }
  }

  /* Vignette & Scanlines */
  .vs__bg-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 38%, rgba(0,0,0,0.60) 100%),
      linear-gradient(to right, rgba(0,0,0,0.40) 0%, transparent 24%, transparent 76%, rgba(0,0,0,0.30) 100%),
      linear-gradient(to bottom, rgba(0,0,0,0.20) 0%, transparent 20%, transparent 76%, rgba(0,0,0,0.50) 100%);
    mix-blend-mode: multiply;
  }

  .vs__bg-scanline {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0,0,0,0.15) 3px,
      rgba(0,0,0,0.15) 4px
    );
    pointer-events: none;
    opacity: 0.6;
  }

  /* Geometric Overlays */
  .vs__geo {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .vs__geo div { position: absolute; border-radius: 3px; }
  .vs__geo-a { width: 30%; height: 95%; top: -3%; left: -5%; transform: rotate(-4.5deg); background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.03); }
  .vs__geo-b { width: 20%; height: 56%; top: 22%; left: 23%; transform: rotate(2.5deg); background: rgba(255,255,255,0.005); border: 1px solid rgba(255,255,255,0.02); }
  .vs__geo-c { width: 22%; height: 84%; top: 6%; right: 3%; transform: rotate(3.2deg); background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.02); }
  .vs__geo-d { width: 10%; height: 34%; bottom: 4%; right: 15%; transform: rotate(-2.8deg); background: rgba(var(--vs-neon-rgb), 0.01); border: 1px solid rgba(var(--vs-neon-rgb), 0.05); }

  /* Watermark */
  .vs__wm {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    width: 100%;
  }
  .vs__wm-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(8rem, 25vw, 30rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.03);
    line-height: 0.85;
    white-space: nowrap;
    user-select: none;
  }

  /* ==========================================================
     CONTENT & BENTO GRID
     ========================================================== */
  .vs__container {
    position: relative;
    z-index: 10;
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 clamp(1.2rem, 4vw, 3rem);
  }

  /* Header */
  .vs__header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vs__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--vs-neon);
    margin-bottom: 1.5rem;
    padding: 0.5rem 1.2rem;
    border: 1px solid rgba(var(--vs-neon-rgb), 0.3);
    border-radius: 100px;
    background: rgba(var(--vs-neon-rgb), 0.05);
    backdrop-filter: blur(10px);
  }
  .vs__label::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--vs-neon);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--vs-neon);
    animation: vs-pulse 2s infinite;
  }
  @keyframes vs-pulse {
    0% { box-shadow: 0 0 0 0 rgba(var(--vs-neon-rgb), 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(var(--vs-neon-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--vs-neon-rgb), 0); }
  }

  .vs__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem 0;
    text-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .vs__subheading {
    max-width: 500px;
    color: #a0a0a0;
    font-size: 1.1rem;
    line-height: 1.6;
    font-weight: 400;
    margin: 0;
  }

  /* Grid Layout */
  .vs__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .vs__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 350px;
    }
  }

  @media (min-width: 1024px) {
    .vs__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 320px;
    }
    
    /* Dynamic Asymmetrical Bento Grid (Repeats every 6 items) */
    .vs__card-wrap:nth-child(6n+1) { grid-column: span 2; grid-row: span 2; } /* Hero */
    .vs__card-wrap:nth-child(6n+2) { grid-column: span 1; grid-row: span 1; } /* Standard */
    .vs__card-wrap:nth-child(6n+3) { grid-column: span 1; grid-row: span 2; } /* Vertical */
    .vs__card-wrap:nth-child(6n+4) { grid-column: span 1; grid-row: span 1; } /* Standard */
    .vs__card-wrap:nth-child(6n+5) { grid-column: span 2; grid-row: span 1; } /* Horizontal */
    .vs__card-wrap:nth-child(6n+6) { grid-column: span 2; grid-row: span 1; } /* Horizontal */
  }

  /* Mobile Swipe Gallery */
  @media (max-width: 767px) {
    .vs__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: 2rem;
      scrollbar-width: none;  
      margin: 0 -1.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
    .vs__grid::-webkit-scrollbar { display: none; }
    
    .vs__card-wrap {
      flex: 0 0 85vw;
      height: 55vh;
      min-height: 400px;
      scroll-snap-align: center;
    }
    /* Padding for last item peek */
    .vs__card-wrap:last-child {
      margin-right: 1.5rem;
    }
  }

  /* Card Styles */
  .vs__card {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #0a0a0a;
    border: 1px solid var(--vs-glass-border);
    transform: translateZ(0); 
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    display: block;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .vs__card:hover {
    border-color: rgba(var(--vs-neon-rgb), 0.4);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.8), 0 0 40px rgba(var(--vs-neon-rgb), 0.15);
    transform: translateY(-5px);
  }

  .vs__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }
  
  .vs__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }

  .vs__card:hover .vs__media {
    transform: scale(1.06);
  }

  /* Overlays */
  .vs__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.85) 100%);
    z-index: 3;
    transition: background 0.6s ease;
  }

  .vs__card:hover .vs__overlay {
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.95) 100%);
  }

  /* UI Layer */
  .vs__ui {
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .vs__ui-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .vs__badge {
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  
  .vs__badge.vs__badge-neon {
    border-color: var(--vs-neon);
    color: var(--vs-neon);
    background: rgba(var(--vs-neon-rgb), 0.05);
    box-shadow: 0 0 15px rgba(var(--vs-neon-rgb), 0.2);
  }

  .vs__icon-wrap {
    width: 32px;
    height: 32px;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(12px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
  }

  .vs__ui-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    transform: translateY(10px);
    opacity: 0.8;
    transition: all 0.4s ease;
  }

  .vs__card:hover .vs__ui-footer {
    transform: translateY(0);
    opacity: 1;
  }

  .vs__user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vs__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #222;
    border: 1px solid var(--vs-neon);
    padding: 2px;
  }
  
  .vs__avatar img {
    border-radius: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vs__username {
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
    color: #fff;
  }
  
  .vs__view-text {
    font-size: 0.7rem;
    color: var(--vs-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.4s ease;
    display: block;
    margin-top: 2px;
  }
  
  .vs__card:hover .vs__view-text {
    opacity: 1;
    transform: translateX(0);
  }

  .vs__stats {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
  }

  .vs__stat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* CTA Area */
  .vs__cta-wrap {
    margin-top: clamp(4rem, 8vw, 6rem);
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .vs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.2rem 3.5rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--vs-neon);
    border-radius: 100px;
    color: #fff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .vs__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--vs-neon);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }

  .vs__btn:hover {
    color: #000;
    box-shadow: 0 10px 40px rgba(var(--vs-neon-rgb), 0.3);
    transform: translateY(-3px);
  }

  .vs__btn:hover::before {
    opacity: 1;
  }

  /* Reveal Animations */
  [data-vs-anim] {
    opacity: 0;
  }
  
  .vs--ready [data-vs-anim="fade-up"] {
    animation: vs-fade-up 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes vs-fade-up {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }

</style>

<section class="vantique-social" id="vs-{{ section.id }}">
  
  <!-- BACKGROUND EFFECTS (Cinematic Layering) -->
  <div class="vs__bg" aria-hidden="true">
    <div class="vs__bg-base"></div>
    <div class="vs__bg-glow-l"></div>
    <div class="vs__bg-glow-c"></div>
    <div class="vs__bg-glow-r"></div>
    <div class="vs__bg-glow-spot"></div>
    <div class="vs__bg-vignette"></div>
    <div class="vs__bg-scanline"></div>
  </div>

  <div class="vs__geo" aria-hidden="true">
    <div class="vs__geo-a"></div>
    <div class="vs__geo-b"></div>
    <div class="vs__geo-c"></div>
    <div class="vs__geo-d"></div>
  </div>

  <div class="vs__wm" aria-hidden="true">
    <span class="vs__wm-text">VANTIQUE</span>
  </div>

  <!-- CONTENT -->
  <div class="vs__container">
    
    <header class="vs__header">
      <div data-vs-anim="fade-up" style="--d:0ms">
        <span class="vs__label">{{ top_label }}</span>
      </div>
      <h2 class="vs__heading" data-vs-anim="fade-up" style="--d:100ms">
        {{ heading }}
      </h2>
      <p class="vs__subheading" data-vs-anim="fade-up" style="--d:200ms">
        {{ subheading }}
      </p>
    </header>

    <div class="vs__grid">
      {% for block in section.blocks %}
        <div class="vs__card-wrap" data-vs-anim="fade-up" style="--d:{{ forloop.index | times: 100 | plus: 200 }}ms" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="vs__card">
            
            {%- if block.settings.video_url != blank -%}
              <video class="vs__video vs__media" autoplay loop muted playsinline>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'vs__media', loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'vs__media' }}
            {%- endif -%}

            <div class="vs__overlay"></div>

            <div class="vs__ui">
              <div class="vs__ui-header">
                {% if block.settings.badge_text != blank %}
                  <span class="vs__badge {% if block.settings.highlight_badge %}vs__badge-neon{% endif %}">
                    {{ block.settings.badge_text }}
                  </span>
                {% else %}
                  <div></div> <!-- Spacer -->
                {% endif %}
                
                <div class="vs__icon-wrap">
                  {% if block.settings.video_url != blank %}
                    <!-- Reel/Play Icon -->
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  {% else %}
                    <!-- IG Icon -->
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                  {% endif %}
                </div>
              </div>

              <div class="vs__ui-footer">
                <div class="vs__user">
                  <div class="vs__avatar">
                    {% if section.settings.brand_avatar != blank %}
                      {{ section.settings.brand_avatar | image_url: width: 80 | image_tag: loading: 'lazy' }}
                    {% else %}
                      <div style="width:100%; height:100%; background:var(--vs-neon); border-radius:50%;"></div>
                    {% endif %}
                  </div>
                  <div>
                    <div class="vs__username">{{ ig_handle }}</div>
                    <span class="vs__view-text">View Post →</span>
                  </div>
                </div>

                <div class="vs__stats">
                  <div class="vs__stat">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    <span>{{ block.settings.likes }}</span>
                  </div>
                  <div class="vs__stat">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    <span>{{ block.settings.comments }}</span>
                  </div>
                </div>
              </div>
            </div>
            
          </a>
        </div>
      {% endfor %}
    </div>

    {% if cta_text != blank %}
      <div class="vs__cta-wrap" data-vs-anim="fade-up" style="--d: 600ms;">
        <a href="{{ cta_link }}" class="vs__btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          {{ cta_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
  // Setup intersection observer for entry animations
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('vs-{{ section.id }}');
    
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          section.classList.add('vs--ready');
          obs.disconnect(); // Only run once
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  });
</script>

{% schema %}
{
  "name": "Vantique Social Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "FOLLOW THE MOVEMENT"
    },
    {
