<script>
(function(){
  'use strict';

  const isReduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  function initVNF(wrap){
    if(!wrap || wrap._vnfInit) return;
    wrap._vnfInit = true;

    // ── 1. Scroll Reveal ─────────────────────────────────
    const revealEls = wrap.querySelectorAll('[data-vnf-reveal]');

    function checkReveal(){
      revealEls.forEach(el => {
        const r = el.getBoundingClientRect();
        if(r.top < window.innerHeight * 0.92){
          el.classList.add('vnf-visible');
        }
      });
    }

    if(isReduced){
      revealEls.forEach(el => el.classList.add('vnf-visible'));
    } else {
      window.addEventListener('scroll', checkReveal, { passive:true });
      checkReveal();
    }

    // ── 2. Newsletter Form ───────────────────────────────
    const form = wrap.querySelector('#vnf-newsletter-form');
    if(form){
      const formInner  = form.querySelector('[id^="vnf-form-"]');
      const successBox = form.querySelector('[id^="vnf-success-"]');
      const emailInput = form.querySelector('.vnf-form-input');

      form.addEventListener('submit', function(e){
        // Let Shopify handle actual submission — just show success UI
        if(emailInput && emailInput.value.includes('@')){
          setTimeout(() => {
            if(formInner)  formInner.style.display  = 'none';
            if(successBox) successBox.style.display = 'flex';
          }, 600);
        }
      });
    }

    // ── 3. Mobile Accordion Menus ────────────────────────
    const accordions = wrap.querySelectorAll('[data-vnf-accordion]');
    accordions.forEach(btn => {
      btn.addEventListener('click', () => {
        const col   = btn.closest('.vnf-menu-col');
        const isOpen = col.classList.contains('open');
        // Close all
        wrap.querySelectorAll('.vnf-menu-col.open').forEach(c => {
          c.classList.remove('open');
          c.querySelector('[data-vnf-accordion]').setAttribute('aria-expanded','false');
        });
        // Open clicked if was closed
        if(!isOpen){
          col.classList.add('open');
          btn.setAttribute('aria-expanded','true');
        }
      });
    });

    // ── 4. Back to Top ────────────────────────────────────
    const bttBtn = wrap.querySelector('[id^="vnf-btt-"]');
    if(bttBtn){
      bttBtn.addEventListener('click', () => {
        window.scrollTo({ top:0, behavior: isReduced ? 'auto' : 'smooth' });
      });
    }

    // ── 5. Form Input Micro Interaction ─────────────────
    const emailInput2 = wrap.querySelector('.vnf-form-input');
    const formEl      = wrap.querySelector('.vnf-form');
    if(emailInput2 && formEl && !isReduced){
      emailInput2.addEventListener('focus', () => {
        formEl.style.transform = 'scale(1.012)';
      });
      emailInput2.addEventListener('blur', () => {
        formEl.style.transform = '';
      });
      formEl.style.transition = 'border-color 0.35s ease, box-shadow 0.35s ease, transform 0.4s cubic-bezier(0.16,1,0.3,1)';
    }

    // ── 6. Social Icon Stagger Float ────────────────────
    if(!isReduced){
      wrap.querySelectorAll('.vnf-social-btn').forEach((btn, i) => {
        btn.style.animationDelay = (i * 0.12) + 's';
      });
    }

    // ── 7. Menu Link Hover Glow Effect ──────────────────
    wrap.querySelectorAll('.vnf-menu-list li a').forEach(link => {
      link.addEventListener('mouseenter', () => {
        link.style.textShadow = '0 0 12px rgba(198,255,0,0.2)';
      });
      link.addEventListener('mouseleave', () => {
        link.style.textShadow = '';
      });
    });

    // ── 8. Cursor Trail (Desktop) ────────────────────────
    const isMobile = window.matchMedia('(max-width:767px)').matches;
    if(!isReduced && !isMobile){
      const trail = document.createElement('div');
      Object.assign(trail.style, {
        position:'fixed',
        width:'150px', height:'150px',
        borderRadius:'50%',
        background:'radial-gradient(circle,rgba(198,255,0,0.044) 0%,transparent 70%)',
        pointerEvents:'none',
        transform:'translate(-50%,-50%)',
        zIndex:'9996',
        opacity:'0',
        filter:'blur(15px)',
        transition:'opacity 0.3s ease',
        willChange:'transform',
      });
      document.body.appendChild(trail);

      wrap.addEventListener('mouseenter', () => { trail.style.opacity = '1'; });
      wrap.addEventListener('mouseleave', () => { trail.style.opacity = '0'; });
      document.addEventListener('mousemove', e => {
        requestAnimationFrame(() => {
          trail.style.transform = `translate(calc(${e.clientX}px - 50%),calc(${e.clientY}px - 50%))`;
        });
      }, { passive:true });
    }

  }

  // ── Boot ──────────────────────────────────────────────
  function boot(){
    document.querySelectorAll('[id^="vnf-"]').forEach(el => {
      if(el.classList.contains('vnf-wrap') || el.querySelector('.vnf-wrap')){
        const target = el.classList.contains('vnf-wrap') ? el : el.querySelector('.vnf-wrap');
        if(target) initVNF(target);
      }
    });
    document.querySelectorAll('.vnf-wrap').forEach(initVNF);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  // ── Shopify Editor ────────────────────────────────────
  document.addEventListener('shopify:section:load', e => {
    const w = e.target.querySelector('.vnf-wrap');
    if(w){ w._vnfInit = false; setTimeout(() => initVNF(w), 80); }
  });
  document.addEventListener('shopify:section:unload', e => {
    const w = e.target.querySelector('.vnf-wrap');
    if(w) w._vnfInit = false;
  });

})();
</script>

