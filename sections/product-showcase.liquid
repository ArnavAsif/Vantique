{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'NEW ERA STREETWEAR'
  assign heading = section.settings.heading | default: 'Featured Collection'
  assign subheading = section.settings.subheading
  assign collection = collections[section.settings.collection]
  assign product_count = section.settings.product_count | default: 4
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign btn_text = section.settings.btn_text | default: 'ADD TO CART'

  assign bg_color = section.settings.bg_color | default: '#050505'
  assign card_bg = section.settings.card_bg | default: 'rgba(255, 255, 255, 0.03)'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#c6ff00'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<section class="v-showcase" id="v-showcase-{{ section.id }}" style="
  --v-bg: {{ bg_color }};
  --v-card-bg: {{ card_bg }};
  --v-text: {{ text_color }};
  --v-accent: {{ accent_color }};
  --v-cols-desktop: {{ columns_desktop }};
">

  <!-- Ambient Background Glows -->
  <div class="v-showcase__ambient v-showcase__ambient--1"></div>
  <div class="v-showcase__ambient v-showcase__ambient--2"></div>
  <div class="v-showcase__noise"></div>

  <div class="v-showcase__container">

    <!-- Header Area -->
    <div class="v-showcase__header js-scroll-anim">
      <div class="v-showcase__eyebrow">
        <span class="v-showcase__line"></span>
        {{ eyebrow }}
        <span class="v-showcase__line"></span>
      </div>
      <h2 class="v-showcase__title">
        {{ heading }}
        <span class="v-showcase__title-underline"></span>
      </h2>
      {%- if subheading != blank -%}
        <p class="v-showcase__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Product Grid / Mobile Slider -->
    <div class="v-showcase__grid js-scroll-anim">

      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: product_count -%}
          {%- assign delay = forloop.index0 | times: 0.15 -%}

          <div class="v-card" style="--anim-delay: {{ delay }}s;">
            <!-- Card Background Layer -->
            <div class="v-card__bg-layer">
              <span class="v-card__bg-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div class="v-card__corner v-card__corner--tl"></div>
              <div class="v-card__corner v-card__corner--tr"></div>
              <div class="v-card__corner v-card__corner--bl"></div>
              <div class="v-card__corner v-card__corner--br"></div>
              <div class="v-card__tech-label">[SYS.REQ.00{{ forloop.index }}]</div>
            </div>

            <!-- Floating Image -->
            <a href="{{ product.url }}" class="v-card__img-wrapper">
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                class="v-card__img"
                loading="lazy"
                decoding="async"
              >
            </a>

            <!-- Content -->
            <div class="v-card__content">
              <div class="v-card__meta">
                <span class="v-card__vendor">{{ product.vendor | default: 'VANTIQUE' }}</span>
                {%- if product.available -%}
                  <span class="v-card__status">IN STOCK</span>
                {%- else -%}
                  <span class="v-card__status v-card__status--soldout">SOLD OUT</span>
                {%- endif -%}
              </div>

              <a href="{{ product.url }}" class="v-card__title-link">
                <h3 class="v-card__title">{{ product.title }}</h3>
              </a>

              <div class="v-card__bottom">
                <div class="v-card__price">{{ product.price | money }}</div>

                {%- if product.available -%}
                  <!-- Add To Cart Button -->
                  <button type="button" class="v-card__btn js-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                    <span class="v-card__btn-text">{{ btn_text }}</span>
                    <svg class="v-card__btn-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <div class="v-card__btn-loader"></div>
                  </button>
                {%- else -%}
                  <!-- Sold Out Button -->
                  <button type="button" class="v-card__btn v-card__btn--soldout" disabled>
                    SOLD OUT
                  </button>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        <!-- Empty State (Editor Onboarding) -->
        {%- for i in (1..product_count) -%}
          {%- assign delay = forloop.index0 | times: 0.15 -%}
          <div class="v-card" style="--anim-delay: {{ delay }}s;">
            <div class="v-card__bg-layer">
              <span class="v-card__bg-number">0{{ i }}</span>
              <div class="v-card__corner v-card__corner--tl"></div>
              <div class="v-card__corner v-card__corner--tr"></div>
              <div class="v-card__corner v-card__corner--bl"></div>
              <div class="v-card__corner v-card__corner--br"></div>
              <div class="v-card__tech-label">[SYS.REQ.00{{ i }}]</div>
            </div>
            <a href="#" class="v-card__img-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'v-card__img v-card__img--placeholder' }}
            </a>
            <div class="v-card__content">
              <div class="v-card__meta">
                <span class="v-card__vendor">VANTIQUE</span>
                <span class="v-card__status">IN STOCK</span>
              </div>
              <h3 class="v-card__title">Futuristic Streetwear Concept</h3>
              <div class="v-card__bottom">
                <div class="v-card__price">$250.00</div>
                <button type="button" class="v-card__btn">
                  <span class="v-card__btn-text">{{ btn_text }}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>
  </div>
</section>

<style>
/* ==========================================================
   VANTIQUE PRODUCT SHOWCASE
   Futuristic Editorial / Luxury Streetwear UI
   ========================================================== */

:root {
  --v-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --v-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
}

.v-showcase {
  position: relative;
  background-color: var(--v-bg);
  padding: 8rem 0 10rem;
  overflow: hidden;
  font-family: 'Space Grotesk', sans-serif;
  color: var(--v-text);
  isolation: isolate;
  contain: layout paint;
}

/* ── AMBIENT BACKGROUND EFFECTS ── */
.v-showcase__ambient {
  position: absolute;
  width: 50vw;
  height: 50vw;
  border-radius: 50%;
  background: radial-gradient(circle, var(--v-accent) 0%, transparent 65%);
  z-index: -1;
  opacity: 0.25;
  pointer-events: none;
  animation: v-float 10s ease-in-out infinite alternate;
}

.v-showcase__ambient--1 { top: -10%; left: -10%; }
.v-showcase__ambient--2 { bottom: 10%; right: -20%; animation-delay: -5s; }

@keyframes v-float {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(5%, 10%) scale(1.1); }
}

.v-showcase__noise {
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: 0.04;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* ── LAYOUT CONTAINER ── */
.v-showcase__container { max-width: 1680px; margin: 0 auto; padding: 0 4vw; }

/* ── HEADER ── */
.v-showcase__header {
  text-align: center;
  margin-bottom: 7rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 1s var(--v-ease-out), transform 1s var(--v-ease-out);
}
.v-showcase__header.is-visible { opacity: 1; transform: translateY(0); }

.v-showcase__eyebrow {
  display: flex; align-items: center; gap: 1rem;
  font-size: 0.75rem; font-weight: 700; letter-spacing: 0.3em;
  color: rgba(255, 255, 255, 0.6); margin-bottom: 1.5rem; text-transform: uppercase;
}
.v-showcase__line { width: 40px; height: 1px; background-color: var(--v-accent); opacity: 0.5; }

.v-showcase__title {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(3rem, 6vw, 5rem); font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.1;
  margin: 0 0 1.5rem 0; position: relative; display: inline-block;
}

.v-showcase__title-underline {
  position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%);
  width: 0; height: 4px; background: var(--v-accent);
  box-shadow: 0 0 15px var(--v-accent);
  transition: width 1s var(--v-ease-out) 0.3s;
}
.v-showcase__header.is-visible .v-showcase__title-underline { width: 60%; }

.v-showcase__subheading {
  max-width: 600px; font-size: 1rem; line-height: 1.6;
  color: rgba(255, 255, 255, 0.5); font-weight: 400; letter-spacing: 0.02em;
}

/* ── GRID / DESKTOP ── */
.v-showcase__grid {
  display: grid;
  grid-template-columns: repeat(var(--v-cols-desktop), 1fr);
  gap: 6rem 2rem;
}

/* ── PRODUCT CARD ── */
.v-card {
  position: relative; display: flex; flex-direction: column;
  padding-top: 60px;
  opacity: 0; transform: translateY(40px);
  transition: opacity 0.8s var(--v-ease-out), transform 0.8s var(--v-ease-out);
  transition-delay: var(--anim-delay);
}
.v-showcase__grid.is-visible .v-card { opacity: 1; transform: translateY(0); }

/* Glassmorphism Background Layer */
.v-card__bg-layer {
  position: absolute; inset: 60px 0 0 0;
  background: var(--v-card-bg);
  border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 28px;
  overflow: hidden; z-index: 1;
  transition: border-color 0.4s ease;
}
.v-card:hover .v-card__bg-layer {
  border-color: rgba(198, 255, 0, 0.3);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), inset 0 0 40px rgba(198, 255, 0, 0.05);
}

/* Big Background Number */
.v-card__bg-number {
  position: absolute; top: -15px; right: -5px;
  font-family: 'Oswald', sans-serif; font-size: 10rem; font-weight: 700;
  line-height: 1; color: rgba(255, 255, 255, 0.03); z-index: 0;
  user-select: none; transition: color 0.4s ease, transform 0.4s ease;
}
.v-card:hover .v-card__bg-number { color: rgba(198, 255, 0, 0.05); transform: translateY(-10px); }

/* Futuristic Corners */
.v-card__corner { position: absolute; width: 15px; height: 15px; border: 1px solid rgba(255, 255, 255, 0.2); z-index: 2; transition: border-color 0.3s ease; }
.v-card__corner--tl { top: 15px; left: 15px; border-right: none; border-bottom: none; }
.v-card__corner--tr { top: 15px; right: 15px; border-left: none; border-bottom: none; }
.v-card__corner--bl { bottom: 15px; left: 15px; border-right: none; border-top: none; }
.v-card__corner--br { bottom: 15px; right: 15px; border-left: none; border-top: none; }
.v-card:hover .v-card__corner { border-color: var(--v-accent); }

/* Small Tech Label */
.v-card__tech-label {
  position: absolute; left: 25px; bottom: 25px;
  font-size: 0.55rem; font-family: monospace; color: rgba(255, 255, 255, 0.3);
  transform: rotate(-90deg); transform-origin: left bottom; letter-spacing: 0.1em;
}

/* Floating Image */
.v-card__img-wrapper {
  position: relative; z-index: 2; width: 85%;
  margin: -60px auto 0; aspect-ratio: 4 / 5;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.6s var(--v-ease-out);
}
.v-card__img {
  width: 100%; height: 100%; object-fit: contain;
  filter: drop-shadow(0 20px 25px rgba(0, 0, 0, 0.6));
  transition: transform 0.6s var(--v-ease-out);
}
.v-card__img--placeholder { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 2rem; }
.v-card:hover .v-card__img-wrapper { transform: translateY(-20px) scale(1.05); }
.v-card:hover .v-card__img { transform: rotate(3deg); filter: drop-shadow(0 30px 35px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 20px rgba(198, 255, 0, 0.2)); }

/* Card Content */
.v-card__content { position: relative; z-index: 2; padding: 1.5rem 2rem 2.5rem; display: flex; flex-direction: column; flex-grow: 1; }
.v-card__meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
.v-card__vendor { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); }
.v-card__status { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; color: var(--v-accent); background: rgba(198, 255, 0, 0.1); padding: 3px 8px; border-radius: 50px; }
.v-card__status--soldout { color: #ff3333; background: rgba(255, 51, 51, 0.1); }
.v-card__title-link { text-decoration: none; color: var(--v-text); }
.v-card__title { font-family: 'Oswald', sans-serif; font-size: 1.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.2; margin: 0 0 2rem 0; transition: color 0.3s ease; }
.v-card:hover .v-card__title { color: var(--v-accent); }
.v-card__bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 10px;}
.v-card__price { font-size: 1.25rem; font-weight: 700; letter-spacing: 0.05em; }

/* ── ADD TO CART BUTTON ── */
.v-card__btn {
  position: relative;
  display: flex; align-items: center; gap: 8px;
  background: transparent; border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--v-text); font-size: 0.75rem; font-weight: 700;
  letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer;
  padding: 0.6rem 1.2rem; border-radius: 50px;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  overflow: hidden;
}

.v-card:hover .v-card__btn:not(:disabled) {
  background: var(--v-accent);
  border-color: var(--v-accent);
  color: #000;
  box-shadow: 0 5px 20px rgba(198, 255, 0, 0.3);
}

.v-card__btn-icon { transition: transform 0.3s ease; }
.v-card:hover .v-card__btn-icon { transform: rotate(90deg); }

.v-card__btn--soldout {
  opacity: 0.4; cursor: not-allowed;
}

/* Loading State for Button */
.v-card__btn.is-loading .v-card__btn-text,
.v-card__btn.is-loading .v-card__btn-icon {
  opacity: 0;
}
.v-card__btn-loader {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 16px; height: 16px;
  border: 2px solid rgba(0,0,0,0.2);
  border-top-color: currentColor;
  border-radius: 50%;
  opacity: 0; visibility: hidden;
  transition: opacity 0.3s;
}
.v-card__btn.is-loading .v-card__btn-loader {
  opacity: 1; visibility: visible;
  animation: v-spin 0.8s linear infinite;
}
@keyframes v-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

/* ==========================================================
   RESPONSIVE LAYOUTS
   ========================================================== */
@media screen and (max-width: 1200px) { .v-showcase__grid { grid-template-columns: repeat(3, 1fr); } }
@media screen and (max-width: 992px) {
  .v-showcase__grid { grid-template-columns: repeat(2, 1fr); gap: 5rem 1.5rem; }
  .v-showcase__title { font-size: clamp(2.5rem, 5vw, 4rem); }
}

@media screen and (max-width: 768px) {
  .v-showcase { padding: 5rem 0 6rem; }
  .v-showcase__container { padding: 0; }
  .v-showcase__header { padding: 0 5vw; margin-bottom: 5rem; }
  .v-showcase__grid {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    gap: 1.5rem; padding: 0 5vw 2rem; -ms-overflow-style: none; scrollbar-width: none;
  }
  .v-showcase__grid::-webkit-scrollbar { display: none; }
  .v-card {
    flex: 0 0 85vw; scroll-snap-align: center;
    transform: translateY(0) scale(0.98); opacity: 0.5; transition: transform 0.4s ease, opacity 0.4s ease;
  }
  .v-showcase__grid.is-visible .v-card { opacity: 0.7; }
  .v-showcase__grid.is-visible .v-card:focus-within, .v-showcase__grid.is-visible .v-card:active, .v-showcase__grid.is-visible .v-card:hover {
    transform: translateY(0) scale(1); opacity: 1;
  }
  .v-card__img-wrapper { margin: -40px auto 0; }
  .v-card__bg-layer { inset: 40px 0 0 0; }
  .v-card__content { padding: 1rem 1.5rem 2rem; }
  .v-card__title { font-size: 1.35rem; }
  .v-card__price { font-size: 1.1rem; }
  .v-card__btn { padding: 0.5rem 1rem; font-size: 0.7rem; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const section = document.getElementById('v-showcase-{{ section.id }}');
  if (!section) return;

  // ── INTERSECTION OBSERVER FOR SCROLL ANIMATIONS ──
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.1 });

  section.querySelectorAll('.js-scroll-anim').forEach(el => observer.observe(el));

  // ── MOBILE SWIPE SNAPPING OPACITY ──
  const grid = section.querySelector('.v-showcase__grid');
  if (window.innerWidth <= 768 && grid) {
    const cards = Array.from(grid.querySelectorAll('.v-card'));
    let cardMetrics = cards.map(c => ({
      el: c,
      center: c.offsetLeft + c.offsetWidth / 2,
      halfWidth: c.offsetWidth / 2
    }));

    const highlightActiveCard = () => {
      const gridCenter = grid.scrollLeft + grid.offsetWidth / 2;
      cardMetrics.forEach(({el, center, halfWidth}) => {
        if (Math.abs(gridCenter - center) < halfWidth) {
          el.style.opacity = '1';
          el.style.transform = 'scale(1)';
        } else {
          el.style.opacity = '0.5';
          el.style.transform = 'scale(0.95)';
        }
      });
    };

    grid.addEventListener('scroll', () => requestAnimationFrame(highlightActiveCard), { passive: true });
    window.addEventListener('resize', () => {
      cardMetrics = cards.map(c => ({
        el: c,
        center: c.offsetLeft + c.offsetWidth / 2,
        halfWidth: c.offsetWidth / 2
      }));
      highlightActiveCard();
    });
    setTimeout(highlightActiveCard, 100);
  }

  // ── AJAX ADD TO CART LOGIC & DRAWER INTEGRATION ──

  const formatMoney = (cents) => {
    if (isNaN(cents) || cents == null) return 0;
    return '$' + (cents / 100.0).toFixed(2);
  };

  const refreshCartDrawerUI = () => {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        document.querySelectorAll('.js-cart-count').forEach(el => el.textContent = cart.item_count);

        const totalEl = document.querySelector('.js-cart-total');
        if (totalEl) totalEl.textContent = formatMoney(cart.total_price);

        const container = document.querySelector('.js-cart-items-container');
        if (container) {
          if (cart.item_count === 0) {
            container.innerHTML = '<p class="v-cart-empty">Your cart is empty.</p>';
          } else {
            let html = '';
            cart.items.forEach((item, index) => {
              let variantHtml = item.variant_title ? `<div class="v-cart-item__variant">${item.variant_title}</div>` : '';
              html += `
                <div class="v-cart-item">
                  <a href="${item.url}"><img src="${item.image || ''}" class="v-cart-item__img" alt="${item.product_title}"></a>
                  <div class="v-cart-item__details">
                    <div>
                      <a href="${item.url}" class="v-cart-item__title">${item.product_title}</a>
                      ${variantHtml}
                      <div class="v-cart-item__price">${formatMoney(item.final_line_price)}</div>
                    </div>
                    <div class="v-cart-item__actions">
                      <div class="v-qty-selector">
                        <button class="v-qty-btn js-qty-change-inner" data-line="${index + 1}" data-qty="${item.quantity - 1}">-</button>
                        <input type="text" class="v-qty-input" value="${item.quantity}" readonly>
                        <button class="v-qty-btn js-qty-change-inner" data-line="${index + 1}" data-qty="${item.quantity + 1}">+</button>
                      </div>
                      <button class="v-cart-item__remove js-qty-change-inner" data-line="${index + 1}" data-qty="0">Remove</button>
                    </div>
                  </div>
                </div>
              `;
            });
            container.innerHTML = html;

            container.querySelectorAll('.js-qty-change-inner').forEach(btn => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                const loader = document.querySelector('.js-cart-loader');
                if (loader) loader.classList.add('is-active');

                fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    line: btn.getAttribute('data-line'),
                    quantity: btn.getAttribute('data-qty')
                  })
                })
                .then(() => refreshCartDrawerUI())
                .finally(() => { if (loader) loader.classList.remove('is-active'); });
              });
            });
          }
        }
      });
  };

  const addToCartBtns = section.querySelectorAll('.js-add-to-cart');

  addToCartBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;

      this.classList.add('is-loading');
      this.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: parseInt(variantId),
            quantity: 1
          }]
        })
      })
      .then(response => response.json())
      .then(data => {
        const overlay = document.querySelector('.js-overlay');
        const cartDrawer = document.querySelector('.js-cart-drawer');

        if (overlay) overlay.classList.add('is-active');
        if (cartDrawer) cartDrawer.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        refreshCartDrawerUI();
      })
      .catch((error) => {
        console.error('Error adding to cart:', error);
        alert('An error occurred while adding to your cart. Please try again.');
      })
      .finally(() => {
        this.classList.remove('is-loading');
        this.disabled = false;
      });
    });
  });

});
</script>

