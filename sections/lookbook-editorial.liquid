<style>
/* ==========================================================
   VANTIQUE EDITORIAL — PERFORMANCE REVISION
   ========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');

:root {
  --ve-lime: #c6ff00;
  --ve-lime-dim: rgba(198, 255, 0, 0.15);
  --ve-lime-glow: rgba(198, 255, 0, 0.35);
  --ve-black: #050505;
  --ve-white: #ffffff;
  --ve-glass: rgba(255, 255, 255, 0.04);
  --ve-glass-border: rgba(198, 255, 0, 0.2);
  --ve-font-display: 'Bebas Neue', 'Impact', 'Arial Narrow', sans-serif;
  --ve-font-body: 'Inter', 'Helvetica Neue', sans-serif;
  --ve-font-mono: 'Space Mono', 'Courier New', monospace;
  --ve-ease: cubic-bezier(0.16, 1, 0.3, 1);
}

.vantique-editorial {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--ve-black);
  isolation: isolate;
  contain: layout paint;
}

/* ═══════════════════════════════════════
   ANIMATED BACKGROUND
═══════════════════════════════════════ */
.ve-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.ve-bg-base {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 30% 50%, rgba(198,255,0,0.07) 0%, transparent 65%),
    radial-gradient(ellipse 50% 80% at 80% 20%, rgba(198,255,0,0.04) 0%, transparent 55%),
    radial-gradient(ellipse 60% 40% at 60% 90%, rgba(198,255,0,0.05) 0%, transparent 60%),
    linear-gradient(160deg, #080808 0%, #050505 40%, #070707 70%, #050505 100%);
  /* FIX: Removed ve-bg-breathe animation (animating background gradients causes full repaints) */
}

/* FIX: Replaced filter:blur(80px) + mix-blend-mode:screen with radial-gradient-only orbs.
   These create a soft glow without the GPU-killing blur rasterization. */
.ve-glow-orb {
  position: absolute;
  border-radius: 50%;
  z-index: -1;
  opacity: 0.45;
  pointer-events: none;
}

.ve-orb-1 {
  width: clamp(280px,45vw,600px);
  height: clamp(280px,45vw,600px);
  background: radial-gradient(circle, rgba(198,255,0,0.35) 0%, rgba(198,255,0,0.12) 40%, transparent 70%);
  top: -20%; left: -8%;
  animation: ve-orb1 18s ease-in-out infinite;
}
.ve-orb-2 {
  width: clamp(220px,38vw,520px);
  height: clamp(220px,38vw,520px);
  background: radial-gradient(circle, rgba(198,255,0,0.28) 0%, rgba(198,255,0,0.08) 40%, transparent 70%);
  bottom: -20%; right: -5%;
  animation: ve-orb2 22s ease-in-out infinite;
}
.ve-orb-3 {
  width: clamp(180px,28vw,400px);
  height: clamp(180px,28vw,400px);
  background: radial-gradient(circle, rgba(198,255,0,0.22) 0%, transparent 70%);
  top: 30%; right: 15%;
  animation: ve-orb3 15s ease-in-out infinite;
}
.ve-orb-4 {
  width: clamp(140px,22vw,340px);
  height: clamp(140px,22vw,340px);
  background: radial-gradient(circle, rgba(198,255,0,0.18) 0%, transparent 70%);
  top: 55%; left: 20%;
  animation: ve-orb4 25s ease-in-out infinite reverse;
}
.ve-orb-5 {
  width: clamp(160px,24vw,360px);
  height: clamp(160px,24vw,360px);
  background: radial-gradient(circle, rgba(198,255,0,0.16) 0%, transparent 70%);
  top: 8%; left: 48%;
  animation: ve-orb5 20s ease-in-out infinite;
}

@keyframes ve-orb1 {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.45; }
  33% { transform: translate(3%,5%) scale(1.06); opacity: 0.6; }
  66% { transform: translate(6%,2%) scale(0.95); opacity: 0.35; }
}
@keyframes ve-orb2 {
  0%,100% { transform: translate(0,0) scale(1); }
  33% { transform: translate(-4%,-6%) scale(1.1); }
  66% { transform: translate(-2%,-3%) scale(0.92); }
}
@keyframes ve-orb3 {
  0%,100% { transform: translate(0,0); opacity: 0.35; }
  50% { transform: translate(-5%,8%); opacity: 0.55; }
}
@keyframes ve-orb4 {
  0%,100% { transform: translate(0,0); }
  50% { transform: translate(6%,-4%); }
}
@keyframes ve-orb5 {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.3; }
  50% { transform: translate(-8%,5%) scale(1.12); opacity: 0.5; }
}

.ve-mesh-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(198,255,0,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(198,255,0,0.035) 1px, transparent 1px);
  background-size: 55px 55px;
  mask-image: radial-gradient(ellipse 70% 70% at 40% 50%, black 0%, transparent 80%);
  animation: ve-grid 8s ease-in-out infinite;
}
@keyframes ve-grid {
  0%,100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.ve-noise {
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: 0.022;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 180px 180px;
}

.ve-scanlines {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.07) 2px, rgba(0,0,0,0.07) 4px);
  opacity: 0.35;
  pointer-events: none;
}

.ve-neon-fog {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 100% 50% at 20% 100%, rgba(198,255,0,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 80% 40% at 80% 0%, rgba(198,255,0,0.04) 0%, transparent 50%);
  animation: ve-fog 16s ease-in-out infinite;
}
@keyframes ve-fog {
  0%,100% { opacity: 0.7; transform: translateX(0); }
  50% { opacity: 1; transform: translateX(2%); }
}

/* FIX: Reduced from 15 to 8 particles and removed box-shadow glow that forces extra layers. */
.ve-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.ve-particle {
  position: absolute;
  width: 2px;
  height: 2px;
  background: var(--ve-lime);
  border-radius: 50%;
  opacity: 0.7;
}
.ve-p1  { top:15%; left:8%;   animation: ve-pf 14s ease-in-out infinite 0s; }
.ve-p2  { top:35%; left:22%;  animation: ve-pf 18s ease-in-out infinite -2s; }
.ve-p3  { top:55%; left:5%;   animation: ve-pf 12s ease-in-out infinite -4s; }
.ve-p4  { top:75%; left:18%;  animation: ve-pf 20s ease-in-out infinite -1s; }
.ve-p5  { top:90%; left:35%;  animation: ve-pf 16s ease-in-out infinite -6s; }
.ve-p6  { top:10%; left:48%;  animation: ve-pf 22s ease-in-out infinite -3s; }
.ve-p7  { top:40%; left:55%;  animation: ve-pf 15s ease-in-out infinite -8s; }
.ve-p8  { top:70%; left:60%;  animation: ve-pf 19s ease-in-out infinite -5s; }

@keyframes ve-pf {
  0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
  10%  { opacity: 0.7; }
  50%  { transform: translateY(-38px) translateX(14px) scale(1.5); opacity: 0.55; }
  90%  { opacity: 0.3; }
  100% { transform: translateY(-75px) translateX(-10px) scale(0.4); opacity: 0; }
}

/* ═══════════════════════════════════════
   WATERMARK
═══════════════════════════════════════ */
.ve-watermark {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  overflow: hidden;
}
.ve-watermark-text {
  font-family: var(--ve-font-display);
  font-size: clamp(100px,18vw,260px);
  font-weight: 900;
  letter-spacing: -0.02em;
  color: transparent;
  -webkit-text-stroke: 1px rgba(198,255,0,0.055);
  white-space: nowrap;
  opacity: 0.5;
  transform: translateX(-5%) rotate(-2deg);
  animation: ve-wmk 30s ease-in-out infinite;
  user-select: none;
  /* FIX: Removed filter:blur(1px) that caused continuous rasterization. */
}
@keyframes ve-wmk {
  0%,100% { transform: translateX(-5%) rotate(-2deg); opacity: 0.4; }
  50% { transform: translateX(-3%) rotate(-1deg); opacity: 0.6; }
}

/* ═══════════════════════════════════════
   MAIN CONTAINER — GRID LAYOUT
═══════════════════════════════════════ */
.ve-container {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 52fr 48fr;
  width: 100%;
  min-height: clamp(460px, 70vh, 700px);
}

/* ═══════════════════════════════════════
   LEFT — VISUAL SIDE
═══════════════════════════════════════ */
.ve-visual-side {
  position: relative;
  overflow: hidden;
  min-height: clamp(400px, 65vh, 700px);
}

.ve-frame-lines {
  position: absolute;
  inset: 20px;
  z-index: 10;
  pointer-events: none;
}
.ve-corner {
  position: absolute;
  width: 34px;
  height: 34px;
  border-color: rgba(198,255,0,0.5);
  border-style: solid;
  /* FIX: Removed ve-corner-glow box-shadow animation (repaints entire card region). */
}
.ve-corner-tl { top:0; left:0; border-width:1.5px 0 0 1.5px; }
.ve-corner-tr { top:0; right:0; border-width:1.5px 1.5px 0 0; }
.ve-corner-bl { bottom:0; left:0; border-width:0 0 1.5px 1.5px; }
.ve-corner-br { bottom:0; right:0; border-width:0 1.5px 1.5px 0; }

.ve-floating-label {
  position: absolute;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 9px;
  font-family: var(--ve-font-mono);
  font-size: 10px;
  letter-spacing: 0.22em;
  color: rgba(198,255,0,0.7);
  text-transform: uppercase;
}
.ve-label-tl { top:36px; left:36px; animation: ve-lbl 4s ease-in-out infinite; }
.ve-label-br { bottom:100px; right:36px; animation: ve-lbl 4s ease-in-out infinite reverse; }
.ve-label-line { display:block; width:26px; height:1px; background:currentColor; }
@keyframes ve-lbl {
  0%,100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.ve-geo-1 {
  position: absolute;
  top:18%; left:-4%;
  width: 100px; height: 100px;
  border: 1px solid rgba(198,255,0,0.1);
  border-radius: 50%;
  z-index: 8;
  pointer-events: none;
  animation: ve-spin 20s linear infinite;
}
.ve-geo-2 {
  position: absolute;
  bottom:22%; right:-2%;
  width: 70px; height: 70px;
  border: 1px solid rgba(198,255,0,0.08);
  transform: rotate(45deg);
  z-index: 8;
  pointer-events: none;
  animation: ve-spin 15s linear infinite reverse;
}
@keyframes ve-spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

.ve-visual-glow {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(ellipse 60% 75% at 50% 60%, rgba(198,255,0,0.11) 0%, rgba(198,255,0,0.04) 40%, transparent 70%),
    radial-gradient(ellipse 80% 35% at 50% 100%, rgba(198,255,0,0.08) 0%, transparent 60%);
  pointer-events: none;
  animation: ve-vglow 6s ease-in-out infinite;
}
@keyframes ve-vglow {
  0%,100% { opacity: 0.7; }
  50% { opacity: 1; }
}

.ve-media-wrapper {
  position: absolute;
  inset: 0;
  z-index: 2;
  overflow: hidden;
}
.ve-image-container,
.ve-video-container {
  width: 100%;
  height: 100%;
  position: relative;
}
.ve-editorial-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 1.2s var(--ve-ease), filter 0.5s ease;
  filter: saturate(0.9) contrast(1.05);
}
.ve-visual-side:hover .ve-editorial-image {
  transform: scale(1.04);
  filter: saturate(1.05) contrast(1.05);
}
.ve-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(0.85) contrast(1.1);
}

.ve-placeholder-container {
  background: linear-gradient(135deg, #0d0d0d 0%, #080808 100%);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ve-silhouette-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.ve-sil-glow {
  position: absolute;
  width: 280px;
  height: 380px;
  background: radial-gradient(ellipse, rgba(198,255,0,0.1) 0%, transparent 70%);
  animation: ve-vglow 4s ease-in-out infinite;
}
.ve-silhouette-svg {
  position: relative;
  z-index: 2;
  max-height: 85%;
  max-width: 80%;
  /* FIX: Removed animated drop-shadow filter. Static shadow only. */
  filter: drop-shadow(0 0 18px rgba(198,255,0,0.28));
}

.ve-overlay {
  position: absolute;
  pointer-events: none;
  z-index: 3;
}
.ve-ov-bottom {
  bottom:0; left:0; right:0;
  height: 40%;
  background: linear-gradient(to top, rgba(5,5,5,0.9) 0%, rgba(5,5,5,0.35) 40%, transparent 100%);
}
.ve-ov-right {
  top:0; right:0; bottom:0;
  width: 28%;
  background: linear-gradient(to left, rgba(5,5,5,0.85) 0%, rgba(5,5,5,0.25) 60%, transparent 100%);
}
.ve-ov-top {
  top:0; left:0; right:0;
  height: 22%;
  background: linear-gradient(to bottom, rgba(5,5,5,0.5) 0%, transparent 100%);
}

.ve-neon-ref {
  position: absolute;
  bottom: 0; left:0; right:0;
  height: 2.5px;
  background: linear-gradient(90deg, transparent, rgba(198,255,0,0.2) 20%, rgba(198,255,0,0.85) 50%, rgba(198,255,0,0.2) 80%, transparent);
  z-index: 10;
  box-shadow: 0 -8px 24px rgba(198,255,0,0.18);
  animation: ve-ref 4s ease-in-out infinite;
}
/* FIX: Removed box-shadow from keyframes (animating shadow causes repaints). */
@keyframes ve-ref {
  0%,100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* FIX: Removed backdrop-filter: blur(18px). Replaced with more opaque solid background. */
.ve-tag-card {
  position: absolute;
  bottom: 48px;
  left: 30px;
  z-index: 15;
  background: rgba(5,5,5,0.92);
  border: 1px solid rgba(198,255,0,0.2);
  border-radius: 2px;
  padding: 10px 18px;
  display: flex;
  align-items: center;
  gap: 11px;
  animation: ve-card-float 6s ease-in-out infinite;
  overflow: hidden;
}
.ve-tag-card::after {
  content:'';
  position:absolute;
  inset:0;
  background: radial-gradient(ellipse at center, rgba(198,255,0,0.05) 0%, transparent 70%);
  animation: ve-vglow 4s ease-in-out infinite;
}
@keyframes ve-card-float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}
.ve-tag-year {
  font-family: var(--ve-font-display);
  font-size: 20px;
  color: var(--ve-lime);
  letter-spacing: 0.05em;
  line-height: 1;
}
.ve-tag-div {
  width: 1px; height: 18px;
  background: rgba(198,255,0,0.3);
}
.ve-tag-season {
  font-family: var(--ve-font-mono);
  font-size: 9px;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.25em;
}

.ve-scroll-ind {
  position: absolute;
  right: 24px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
}
.ve-scroll-line-v {
  display: block;
  width: 1px; height: 50px;
  background: linear-gradient(to bottom, transparent, rgba(198,255,0,0.5), transparent);
  animation: ve-scrl 2s ease-in-out infinite;
}
.ve-scroll-txt {
  font-family: var(--ve-font-mono);
  font-size: 8px;
  letter-spacing: 0.3em;
  color: rgba(198,255,0,0.45);
  writing-mode: vertical-rl;
}
@keyframes ve-scrl {
  0% { transform:scaleY(0); transform-origin:top; }
  50% { transform:scaleY(1); transform-origin:top; }
  50.01% { transform-origin:bottom; }
  100% { transform:scaleY(0); transform-origin:bottom; }
}

/* ═══════════════════════════════════════
   RIGHT — CONTENT SIDE
═══════════════════════════════════════ */
.ve-content-side {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(32px,5vw,72px) clamp(28px,4.5vw,68px) clamp(32px,5vw,72px) clamp(30px,4vw,60px);
  overflow: hidden;
  z-index: 2;
}

.ve-top-label {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 22px;
}
.ve-label-dot {
  display: block;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--ve-lime);
  box-shadow: 0 0 10px rgba(198,255,0,0.7);
  animation: ve-dot-pulse 2s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes ve-dot-pulse {
  0%,100% { box-shadow:0 0 10px rgba(198,255,0,0.7); transform:scale(1); }
  50% { box-shadow:0 0 20px rgba(198,255,0,1),0 0 38px rgba(198,255,0,0.38); transform:scale(1.15); }
}
.ve-label-tag {
  font-family: var(--ve-font-mono);
  font-size: clamp(9px,1.1vw,11px);
  letter-spacing: 0.25em;
  color: rgba(198,255,0,0.8);
  text-transform: uppercase;
}
.ve-label-line-h {
  display: block; flex:1;
  max-width: 70px; height: 1px;
  background: linear-gradient(to right, rgba(198,255,0,0.3), transparent);
}

.ve-heading-block {
  position: relative;
  margin-bottom: 20px;
}
.ve-main-heading {
  font-family: var(--ve-font-display);
  font-size: clamp(48px,7vw,100px);
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.02em;
  color: var(--ve-white);
  text-transform: uppercase;
  margin: 0;
}
.ve-heading-word { display:block; overflow:hidden; }
/* FIX: Removed text-shadow animation (repaints every frame). Static glow only. */
.ve-heading-accent {
  font-style: normal;
  color: var(--ve-lime);
  text-shadow: 0 0 22px rgba(198,255,0,0.4), 0 0 55px rgba(198,255,0,0.14);
}
.ve-heading-glow {
  position: absolute;
  top:50%; left:-10%;
  transform: translateY(-50%);
  width: 120%; height: 120%;
  background: radial-gradient(ellipse 80% 60% at 30% 50%, rgba(198,255,0,0.055) 0%, transparent 70%);
  pointer-events: none;
  animation: ve-vglow 5s ease-in-out infinite;
}

.ve-sub-label {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 20px;
}
.ve-sub-line {
  display: block; flex:1;
  max-width: 45px; height: 1px;
  background: rgba(255,255,255,0.18);
}
.ve-sub-text {
  font-family: var(--ve-font-mono);
  font-size: clamp(9px,1vw,10.5px);
  letter-spacing: 0.3em;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  white-space: nowrap;
}

.ve-description-block { margin-bottom: 26px; max-width: 460px; }
.ve-description {
  font-family: var(--ve-font-body);
  font-size: clamp(13px,1.3vw,15px);
  line-height: 1.72;
  color: rgba(255,255,255,0.5);
  margin: 0;
  font-weight: 300;
}

.ve-stats-row {
  display: flex;
  align-items: center;
  margin-bottom: 30px;
}
.ve-stat-item {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex:1;
}
.ve-stat-number {
  font-family: var(--ve-font-display);
  font-size: clamp(28px,3.5vw,44px);
  color: var(--ve-lime);
  line-height: 1;
  letter-spacing: -0.02em;
  text-shadow: 0 0 18px rgba(198,255,0,0.38);
}
.ve-stat-label {
  font-family: var(--ve-font-mono);
  font-size: 8.5px;
  letter-spacing: 0.3em;
  color: rgba(255,255,255,0.32);
  text-transform: uppercase;
}
.ve-stat-div {
  width:1px; height:36px;
  background: linear-gradient(to bottom, transparent, rgba(198,255,0,0.2), transparent);
  flex-shrink:0;
  margin: 0 20px;
}

.ve-cta-block {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 26px;
  flex-wrap: wrap;
}

/* Primary Button */
.ve-cta-primary {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 11px;
  padding: 15px 32px;
  text-decoration: none;
  cursor: pointer;
  overflow: hidden;
  isolation: isolate;
  border-radius: 2px;
  animation: ve-btn-float 4s ease-in-out infinite;
  transition: transform 0.15s ease;
}
.ve-btn-bg {
  position: absolute; inset:0;
  background: rgba(5,5,5,0.92);
  z-index: 1;
  /* FIX: Removed backdrop-filter: blur(20px) — massive GPU cost for a button. */
}
.ve-btn-border {
  position: absolute; inset:0;
  border: 1.5px solid rgba(198,255,0,0.5);
  z-index: 2;
  border-radius: inherit;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.ve-btn-glow {
  position: absolute; inset:0;
  background: radial-gradient(ellipse at center, rgba(198,255,0,0.06) 0%, transparent 70%);
  z-index: 2;
  transition: opacity 0.3s ease;
}
.ve-btn-txt {
  position: relative; z-index:5;
  font-family: var(--ve-font-mono);
  font-size: clamp(10px,1.1vw,12px);
  letter-spacing: 0.2em;
  color: var(--ve-white);
  text-transform: uppercase;
  transition: color 0.3s ease;
  white-space: nowrap;
}
.ve-btn-icon {
  position: relative; z-index:5;
  color: var(--ve-lime);
  display: flex;
  align-items: center;
  transition: transform 0.3s var(--ve-ease);
}
.ve-btn-shine {
  position: absolute; inset:0;
  background: linear-gradient(135deg, transparent 0%, transparent 40%, rgba(198,255,0,0.09) 50%, transparent 60%, transparent 100%);
  transform: translateX(-100%);
  z-index: 3;
}
.ve-cta-primary:hover .ve-btn-border {
  border-color: rgba(198,255,0,0.9);
  box-shadow: 0 0 18px rgba(198,255,0,0.28), inset 0 0 18px rgba(198,255,0,0.04);
}
.ve-cta-primary:hover .ve-btn-txt { color: var(--ve-lime); }
.ve-cta-primary:hover .ve-btn-icon { transform: translateX(4px); }
.ve-cta-primary:hover .ve-btn-shine {
  transform: translateX(100%);
  transition: transform 0.55s var(--ve-ease);
}
.ve-cta-primary:active { transform: scale(0.98); }
@keyframes ve-btn-float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}

/* Secondary CTA */
.ve-cta-secondary {
  position: relative;
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  cursor: pointer;
}
.ve-cta-secondary .ve-btn-txt {
  font-family: var(--ve-font-mono);
  font-size: clamp(10px,1vw,11.5px);
  letter-spacing: 0.2em;
  color: rgba(255,255,255,0.45);
  text-transform: uppercase;
  transition: color 0.3s ease;
}
.ve-underline-anim {
  position: absolute;
  bottom: -3px; left:0;
  width:0; height:1px;
  background: var(--ve-lime);
  transition: width 0.4s var(--ve-ease);
  box-shadow: 0 0 8px rgba(198,255,0,0.5);
}
.ve-cta-secondary:hover .ve-btn-txt { color: rgba(255,255,255,0.8); }
.ve-cta-secondary:hover .ve-underline-anim { width: 100%; }

.ve-keyword-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 26px;
}
.ve-keyword-tag {
  font-family: var(--ve-font-mono);
  font-size: 9.5px;
  letter-spacing: 0.2em;
  color: rgba(198,255,0,0.58);
  border: 1px solid rgba(198,255,0,0.14);
  padding: 5px 11px;
  border-radius: 1px;
  background: rgba(198,255,0,0.025);
  transition: all 0.3s ease;
  cursor: default;
}
.ve-keyword-tag:hover {
  color: var(--ve-lime);
  border-color: rgba(198,255,0,0.4);
  background: rgba(198,255,0,0.055);
  box-shadow: 0 0 10px rgba(198,255,0,0.12);
}

/* FIX: Removed backdrop-filter: blur(22px). No visual difference on near-black bg. */
.ve-glass-panel {
  position: relative;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--ve-glass-border);
  border-radius: 3px;
  padding: 16px 20px;
  overflow: hidden;
  max-width: 400px;
}
.ve-glass-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 11px;
}
.ve-glass-row {
  display: flex;
  align-items: center;
  gap: 11px;
}
.ve-glass-icon { display:flex; flex-shrink:0; }
.ve-glass-text {
  font-family: var(--ve-font-body);
  font-size: 12.5px;
  color: rgba(255,255,255,0.5);
  line-height: 1.4;
}
.ve-glass-divider {
  height:1px;
  background: rgba(255,255,255,0.055);
}
.ve-glass-glow {
  position: absolute; inset:0;
  background: radial-gradient(ellipse at top left, rgba(198,255,0,0.04) 0%, transparent 60%);
  animation: ve-vglow 5s ease-in-out infinite reverse;
}

.ve-deco-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.ve-deco-h {
  position: absolute;
  left:-5%; right:-5%; height:1px;
  background: rgba(198,255,0,0.05);
}
.ve-deco-h1 { top:14%; }
.ve-deco-h2 { bottom:19%; }
.ve-deco-dot-el {
  position: absolute;
  width:4px; height:4px;
  border-radius:50%;
  background: rgba(198,255,0,0.28);
  box-shadow: 0 0 8px rgba(198,255,0,0.38);
}
.ve-dd1 { top:14%; right:5%; transform:translateY(-50%); }
.ve-dd2 { bottom:19%; left:5%; transform:translateY(-50%); }

/* ═══════════════════════════════════════
   EDITORIAL TICKER STRIP
═══════════════════════════════════════ */
.ve-editorial-strip {
  position: relative;
  z-index: 3;
  width: 100%;
  overflow: hidden;
  padding: 12px 0;
  border-top: 1px solid rgba(198,255,0,0.07);
  background: rgba(0,0,0,0.28);
  /* FIX: Removed backdrop-filter: blur(4px). */
  flex-shrink: 0;
}
.ve-strip-inner {
  display: flex;
  align-items: center;
  white-space: nowrap;
  animation: ve-strip 30s linear infinite;
  width: max-content;
}
.ve-strip-item {
  font-family: var(--ve-font-mono);
  font-size: 9.5px;
  letter-spacing: 0.25em;
  color: rgba(198,255,0,0.42);
  text-transform: uppercase;
  padding: 0 14px;
}
.ve-strip-sep {
  color: rgba(198,255,0,0.22);
  font-size: 7.5px;
}
@keyframes ve-strip { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ═══════════════════════════════════════
   REVEAL ANIMATIONS
═══════════════════════════════════════ */
[data-reveal="left"],
[data-reveal="right"] {
  opacity: 0;
  transition: opacity 1.2s var(--ve-ease), transform 1.2s var(--ve-ease);
}
[data-reveal="left"] { transform: translateX(-36px); }
[data-reveal="right"] { transform: translateX(36px); transition-delay: 0.15s; }
[data-reveal="left"].ve-revealed,
[data-reveal="right"].ve-revealed { opacity:1; transform:translateX(0); }

[data-ri] {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.9s var(--ve-ease), transform 0.9s var(--ve-ease);
}
[data-ri].ve-revealed { opacity:1; transform:translateY(0); }
[data-ri]:nth-child(1) { transition-delay:0.2s; }
[data-ri]:nth-child(2) { transition-delay:0.35s; }
[data-ri]:nth-child(3) { transition-delay:0.5s; }
[data-ri]:nth-child(4) { transition-delay:0.65s; }
[data-ri]:nth-child(5) { transition-delay:0.8s; }
[data-ri]:nth-child(6) { transition-delay:0.95s; }
[data-ri]:nth-child(7) { transition-delay:1.1s; }
[data-ri]:nth-child(8) { transition-delay:1.25s; }

.ve-cta-primary:focus-visible,
.ve-cta-secondary:focus-visible {
  outline: 2px solid var(--ve-lime);
  outline-offset: 4px;
}

/* ═══════════════════════════════════════
   STATIC MODE (ANIMATIONS OFF)
═══════════════════════════════════════ */
.ve-static .ve-bg-base,
.ve-static .ve-glow-orb,
.ve-static .ve-particle,
.ve-static .ve-mesh-grid,
.ve-static .ve-neon-fog,
.ve-static .ve-visual-glow,
.ve-static .ve-heading-glow,
.ve-static .ve-watermark-text,
.ve-static .ve-sil-glow,
.ve-static .ve-corner,
.ve-static .ve-strip-inner,
.ve-static .ve-tag-card::after,
.ve-static .ve-btn-shine,
.ve-static .ve-label-dot,
.ve-static .ve-editorial-strip,
.ve-static .ve-neon-ref,
.ve-static .ve-floating-label,
.ve-static .ve-scroll-line-v,
.ve-static .ve-geo-1,
.ve-static .ve-geo-2 {
  animation: none !important;
}

.ve-static [data-reveal="left"],
.ve-static [data-reveal="right"],
.ve-static [data-ri] {
  opacity: 1 !important;
  transform: none !important;
  transition: none !important;
}

.ve-static .ve-cta-primary { animation: none !important; }

/* ═══════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════ */
@media screen and (max-width:1024px) {
  .ve-container { grid-template-columns:1fr 1fr; }
  .ve-main-heading { font-size: clamp(40px,6vw,72px); }
  .ve-description-block { max-width:100%; }
  .ve-glass-panel { max-width:100%; }
  .ve-stat-div { margin: 0 14px; }
  .ve-geo-2, .ve-scroll-ind { display:none; }
}

@media screen and (max-width:900px) {
  .ve-container {
    grid-template-columns: 1fr;
    grid-template-rows: clamp(340px,55vw,500px) auto;
    min-height: auto;
  }
  .ve-visual-side { min-height: clamp(340px,55vw,500px); }
  .ve-content-side { padding: 40px 28px 52px; }
  .ve-main-heading { font-size: clamp(48px,10.5vw,80px); }
  .ve-watermark-text { font-size: clamp(70px,16vw,160px); }
  .ve-ov-right { display:none; }
  .ve-ov-bottom { height:30%; }
  .vantique-editorial { min-height: auto; }
}

@media screen and (max-width:767px) {
  .ve-container {
    grid-template-columns: 1fr;
    grid-template-rows: clamp(320px,80vw,480px) auto;
    min-height: auto;
  }
  .ve-visual-side { min-height: clamp(320px,80vw,480px); max-height:480px; }
  .ve-content-side { padding: 34px 18px 44px; }
  .ve-main-heading { font-size: clamp(44px,13.5vw,70px); line-height:0.88; }
  .ve-heading-block { margin-bottom:16px; }
  .ve-top-label { margin-bottom:16px; }
  .ve-sub-label { margin-bottom:16px; }
  .ve-description { font-size:13.5px; }
  .ve-description-block { margin-bottom:22px; }
  .ve-stats-row { margin-bottom:22px; }
  .ve-stat-number { font-size: clamp(26px,7.5vw,36px); }
  .ve-stat-div { margin:0 12px; }
  .ve-cta-block { flex-direction:column; align-items:flex-start; gap:16px; margin-bottom:22px; }
  .ve-cta-primary { width:100%; justify-content:center; padding:14px 24px; }
  .ve-keyword-tags { margin-bottom:20px; }
  .ve-keyword-tag { font-size:9px; padding:4px 10px; }
  .ve-glass-panel { padding:14px 16px; }
  .ve-glass-text { font-size:12px; }
  .ve-watermark-text { font-size: clamp(60px,20vw,120px); }
  .ve-frame-lines { inset:10px; }
  .ve-corner { width:22px; height:22px; }
  .ve-label-tl { top:18px; left:18px; font-size:9px; }
  .ve-label-br { bottom:80px; right:18px; font-size:9px; }
  .ve-tag-card { bottom:26px; left:18px; padding:9px 14px; }
  .ve-tag-year { font-size:17px; }
  .ve-geo-1, .ve-geo-2, .ve-scroll-ind { display:none; }
  .ve-strip-item { font-size:8.5px; padding:0 10px; }
  .ve-p6,.ve-p7,.ve-p8 { display:none; }
}

@media screen and (max-width:480px) {
  .ve-main-heading { font-size: clamp(40px,13vw,58px); }
  .ve-stat-div { margin:0 8px; }
  .ve-stat-number { font-size: clamp(24px,7vw,32px); }
  .ve-description { font-size:13px; }
  .ve-cta-primary { padding:13px 20px; }
}

@media (prefers-reduced-motion: reduce) {
  *,*::before,*::after {
    animation-duration:0.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:0.3s !important;
  }
}
</style>

<section
  class="vantique-editorial{% unless section.settings.enable_animations %} ve-static{% endunless %}"
  id="vantique-lookbook-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-enable-animations="{{ section.settings.enable_animations }}"
  data-enable-mouse="{{ section.settings.enable_mouse_effects }}"
>

  <!-- ═══ ANIMATED BACKGROUND ═══ -->
  <div class="ve-background" aria-hidden="true">
    <div class="ve-bg-base"></div>
    <div class="ve-glow-orb ve-orb-1"></div>
    <div class="ve-glow-orb ve-orb-2"></div>
    <div class="ve-glow-orb ve-orb-3"></div>
    <div class="ve-glow-orb ve-orb-4"></div>
    <div class="ve-glow-orb ve-orb-5"></div>
    <div class="ve-mesh-grid"></div>
    <div class="ve-noise"></div>
    <div class="ve-scanlines"></div>
    <div class="ve-neon-fog"></div>
    <div class="ve-particles" aria-hidden="true">
      <span class="ve-particle ve-p1"></span>
      <span class="ve-particle ve-p2"></span>
      <span class="ve-particle ve-p3"></span>
      <span class="ve-particle ve-p4"></span>
      <span class="ve-particle ve-p5"></span>
      <span class="ve-particle ve-p6"></span>
      <span class="ve-particle ve-p7"></span>
      <span class="ve-particle ve-p8"></span>
    </div>
  </div>

  <!-- ═══ WATERMARK ═══ -->
  <div class="ve-watermark" aria-hidden="true">
    <span class="ve-watermark-text">{{ section.settings.watermark_text | default: 'VANTIQUE' }}</span>
  </div>

  <!-- ═══ MAIN GRID ═══ -->
  <div class="ve-container">

    <!-- ─── LEFT — VISUAL ─── -->
    <div class="ve-visual-side" data-reveal="left">

      <div class="ve-frame-lines" aria-hidden="true">
        <span class="ve-corner ve-corner-tl"></span>
        <span class="ve-corner ve-corner-tr"></span>
        <span class="ve-corner ve-corner-bl"></span>
        <span class="ve-corner ve-corner-br"></span>
      </div>

      <div class="ve-floating-label ve-label-tl" aria-hidden="true">
        <span class="ve-label-line"></span>
        <span>SS/26</span>
      </div>
      <div class="ve-floating-label ve-label-br" aria-hidden="true">
        <span>EDITORIAL</span>
        <span class="ve-label-line"></span>
      </div>

      <div class="ve-geo-1" aria-hidden="true"></div>
      <div class="ve-geo-2" aria-hidden="true"></div>
      <div class="ve-visual-glow" aria-hidden="true"></div>

      <div class="ve-media-wrapper">

        {% if section.settings.use_video and section.settings.video_url != blank %}
          <div class="ve-video-container">
            <video
              class="ve-video"
              autoplay muted loop playsinline preload="auto"
              {% if section.settings.video_poster != blank %}
                poster="{{ section.settings.video_poster | img_url: '1200x' }}"
              {% endif %}
            >
              <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
          </div>

        {% elsif section.settings.editorial_image != blank %}
          <div class="ve-image-container">
            <img
              class="ve-editorial-image"
              src="{{ section.settings.editorial_image | img_url: '1200x' }}"
              srcset="
                {{ section.settings.editorial_image | img_url: '600x' }} 600w,
                {{ section.settings.editorial_image | img_url: '900x' }} 900w,
                {{ section.settings.editorial_image | img_url: '1200x' }} 1200w,
                {{ section.settings.editorial_image | img_url: '1600x' }} 1600w
              "
              sizes="(max-width:767px) 100vw,(max-width:1024px) 50vw, 52vw"
              alt="{{ section.settings.editorial_image.alt | default: 'VANTIQUE Editorial Fashion' }}"
              loading="lazy"
              decoding="async"
              width="{{ section.settings.editorial_image.width }}"
              height="{{ section.settings.editorial_image.height }}"
            >
          </div>

        {% else %}
          <div class="ve-placeholder-container">
            <div class="ve-silhouette-wrap">
              <div class="ve-sil-glow"></div>
              <!-- FIX: Removed feGaussianBlur SVG filter from placeholder -->
              <svg class="ve-silhouette-svg" viewBox="0 0 400 680" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="sg{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#c6ff00;stop-opacity:0.32"/>
                    <stop offset="50%" style="stop-color:#c6ff00;stop-opacity:0.10"/>
                    <stop offset="100%" style="stop-color:#050505;stop-opacity:0.75"/>
                  </linearGradient>
                </defs>
                <!-- Head -->
                <ellipse cx="200" cy="76" rx="44" ry="50" fill="url(#sg{{ section.id }})"/>
                <!-- Neck -->
                <rect x="186" y="122" width="28" height="28" fill="url(#sg{{ section.id }})"/>
                <!-- Oversized Jacket -->
                <path d="M100 150 L58 195 L48 370 L168 370 L168 150Z" fill="url(#sg{{ section.id }})"/>
                <path d="M300 150 L342 195 L352 370 L232 370 L232 150Z" fill="url(#sg{{ section.id }})"/>
                <rect x="163" y="148" width="74" height="224" fill="url(#sg{{ section.id }})"/>
                <!-- Collar -->
                <path d="M163 150 L200 190 L237 150" stroke="#c6ff00" stroke-width="2" fill="none" opacity="0.8"/>
                <!-- Neon jacket lines -->
                <line x1="163" y1="172" x2="163" y2="368" stroke="#c6ff00" stroke-width="1" opacity="0.45"/>
                <line x1="237" y1="172" x2="237" y2="368" stroke="#c6ff00" stroke-width="1" opacity="0.45"/>
                <!-- Cargo Pants -->
                <rect x="138" y="365" width="62" height="230" rx="7" fill="url(#sg{{ section.id }})"/>
                <rect x="210" y="365" width="62" height="230" rx="7" fill="url(#sg{{ section.id }})"/>
                <!-- Cargo Pockets -->
                <rect x="126" y="428" width="36" height="42" rx="3" fill="none" stroke="#c6ff00" stroke-width="1.4" opacity="0.55"/>
                <rect x="238" y="428" width="36" height="42" rx="3" fill="none" stroke="#c6ff00" stroke-width="1.4" opacity="0.55"/>
                <!-- Sneakers -->
                <ellipse cx="166" cy="603" rx="36" ry="14" fill="#c6ff00" opacity="0.35"/>
                <ellipse cx="234" cy="603" rx="36" ry="14" fill="#c6ff00" opacity="0.35"/>
                <!-- Belt -->
                <rect x="138" y="360" width="124" height="8" rx="2" fill="none" stroke="#c6ff00" stroke-width="1" opacity="0.4"/>
              </svg>
            </div>
          </div>
        {% endif %}

        <div class="ve-overlay ve-ov-bottom"></div>
        <div class="ve-overlay ve-ov-right"></div>
        <div class="ve-overlay ve-ov-top"></div>
        <div class="ve-neon-ref" aria-hidden="true"></div>

      </div>

      <div class="ve-tag-card" aria-label="Collection info">
        <span class="ve-tag-year">2026</span>
        <span class="ve-tag-div"></span>
        <span class="ve-tag-season">{{ section.settings.collection_season | default: 'LOOKBOOK' }}</span>
      </div>

      <div class="ve-scroll-ind" aria-hidden="true">
        <span class="ve-scroll-line-v"></span>
        <span class="ve-scroll-txt">SCROLL</span>
      </div>

    </div>

    <!-- ─── RIGHT — CONTENT ─── -->
    <div class="ve-content-side" data-reveal="right">

      <div class="ve-deco-lines" aria-hidden="true">
        <span class="ve-deco-h ve-deco-h1"></span>
        <span class="ve-deco-h ve-deco-h2"></span>
        <span class="ve-deco-dot-el ve-dd1"></span>
        <span class="ve-deco-dot-el ve-dd2"></span>
      </div>

      <div class="ve-top-label" data-ri>
        <span class="ve-label-dot"></span>
        <span class="ve-label-tag">{{ section.settings.top_label | default: 'VANTIQUE LOOKBOOK 2026' }}</span>
        <span class="ve-label-line-h"></span>
      </div>

      <div class="ve-heading-block" data-ri>
        <h2 class="ve-main-heading">
          {% assign hw = section.settings.main_heading | default: 'FUTURE OF STREETWEAR' | split: ' ' %}
          {% for w in hw %}
            <span class="ve-heading-word">
              {% if forloop.index == 2 or forloop.index == 4 %}
                <em class="ve-heading-accent">{{ w }}</em>
              {% else %}
                {{ w }}
              {% endif %}
            </span>
          {% endfor %}
        </h2>
        <div class="ve-heading-glow" aria-hidden="true"></div>
      </div>

      <div class="ve-sub-label" data-ri>
        <span class="ve-sub-line"></span>
        <span class="ve-sub-text">{{ section.settings.sub_label | default: 'AW / SS 2026 CAMPAIGN' }}</span>
        <span class="ve-sub-line"></span>
      </div>

      <div class="ve-description-block" data-ri>
        <p class="ve-description">{{ section.settings.description | default: 'Where the boundary between fashion and future dissolves. VANTIQUE 2026 is a visual manifesto — draped in oversized silhouettes, cast in neon shadow, and worn by those who move ahead of culture. This is not just clothing. This is identity armor for the next generation.' }}</p>
      </div>

      {%- if section.settings.show_stats -%}
      <div class="ve-stats-row" data-ri>
        <div class="ve-stat-item">
          <span class="ve-stat-number" data-count="{{ section.settings.stat_1_number | default: '48' }}">{{ section.settings.stat_1_number | default: '48' }}</span>
          <span class="ve-stat-label">{{ section.settings.stat_1_label | default: 'PIECES' }}</span>
        </div>
        <div class="ve-stat-div" aria-hidden="true"></div>
        <div class="ve-stat-item">
          <span class="ve-stat-number" data-count="{{ section.settings.stat_2_number | default: '12' }}">{{ section.settings.stat_2_number | default: '12' }}</span>
          <span class="ve-stat-label">{{ section.settings.stat_2_label | default: 'LOOKS' }}</span>
        </div>
        <div class="ve-stat-div" aria-hidden="true"></div>
        <div class="ve-stat-item">
          <span class="ve-stat-number">{{ section.settings.stat_3_number | default: '∞' }}</span>
          <span class="ve-stat-label">{{ section.settings.stat_3_label | default: 'IDENTITY' }}</span>
        </div>
      </div>
      {%- endif -%}

      <div class="ve-cta-block" data-ri>
        <a
          href="{{ section.settings.cta_link | default: '/collections/all' }}"
          class="ve-cta-primary"
          aria-label="{{ section.settings.cta_text | default: 'DISCOVER COLLECTION' }}"
        >
          <span class="ve-btn-bg"></span>
          <span class="ve-btn-border"></span>
          <span class="ve-btn-glow"></span>
          <span class="ve-btn-txt">{{ section.settings.cta_text | default: 'DISCOVER COLLECTION' }}</span>
          <span class="ve-btn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
          <span class="ve-btn-shine"></span>
        </a>
        {% if section.settings.secondary_link != blank %}
          <a
            href="{{ section.settings.secondary_link }}"
            class="ve-cta-secondary"
            aria-label="{{ section.settings.secondary_text | default: 'VIEW CAMPAIGN' }}"
          >
            <span class="ve-btn-txt">{{ section.settings.secondary_text | default: 'VIEW CAMPAIGN' }}</span>
            <span class="ve-underline-anim"></span>
          </a>
        {% endif %}
      </div>

      {%- if section.settings.show_tags -%}
      <div class="ve-keyword-tags" data-ri>
        {% assign tags = section.settings.fashion_tags | default: 'STREETWEAR,FUTURISM,LUXURY,EDITORIAL,2026' | split: ',' %}
        {% for t in tags %}
          <span class="ve-keyword-tag">{{ t | strip }}</span>
        {% endfor %}
      </div>
      {%- endif -%}

      {%- if section.settings.show_info_panel -%}
      <div class="ve-glass-panel" data-ri>
        <div class="ve-glass-inner">
          <div class="ve-glass-row">
            <span class="ve-glass-icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c6ff00" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
              </svg>
            </span>
            <span class="ve-glass-text">{{ section.settings.glass_info_1 | default: 'Limited Edition Drop — Available Now' }}</span>
          </div>
          <div class="ve-glass-divider"></div>
          <div class="ve-glass-row">
            <span class="ve-glass-icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c6ff00" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span class="ve-glass-text">{{ section.settings.glass_info_2 | default: 'Free Global Shipping on orders $200+' }}</span>
          </div>
        </div>
        <div class="ve-glass-glow"></div>
      </div>
      {%- endif -%}

    </div>

  </div>

  <!-- ═══ EDITORIAL TICKER STRIP ═══ -->
  <div class="ve-editorial-strip" aria-hidden="true">
    <div class="ve-strip-inner">
      {% for i in (1..6) %}
        <span class="ve-strip-item">VANTIQUE</span><span class="ve-strip-sep">✦</span>
        <span class="ve-strip-item">FUTURE FASHION</span><span class="ve-strip-sep">✦</span>
        <span class="ve-strip-item">SS26</span><span class="ve-strip-sep">✦</span>
        <span class="ve-strip-item">LUXURY STREETWEAR</span><span class="ve-strip-sep">✦</span>
        <span class="ve-strip-item">EDITORIAL</span><span class="ve-strip-sep">✦</span>
        <span class="ve-strip-item">NEW DROP</span><span class="ve-strip-sep">✦</span>
      {% endfor %}
    </div>
  </div>

</section>

<script>
(function () {
  'use strict';

  function clamp(v, mn, mx) { return Math.min(Math.max(v, mn), mx); }
  function mapRange(v, iMin, iMax, oMin, oMax) {
    return ((v - iMin) * (oMax - oMin)) / (iMax - iMin) + oMin;
  }

  function initSection(section) {
    if (!section || section._veInit) return;
    section._veInit = true;

    const enableAnimations = section.dataset.enableAnimations !== 'false';
    const enableMouse = section.dataset.enableMouse === 'true';
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const runEffects = enableAnimations && !isReduced;
    const runMouse = runEffects && enableMouse;

    const visual = section.querySelector('.ve-visual-side');
    const content = section.querySelector('.ve-content-side');
    const img = section.querySelector('.ve-editorial-image');
    const video = section.querySelector('.ve-video');
    const watermark = section.querySelector('.ve-watermark-text');
    const tagCard = section.querySelector('.ve-tag-card');
    const strip = section.querySelector('.ve-editorial-strip');
    const stripInner = section.querySelector('.ve-strip-inner');
    const revealSides = section.querySelectorAll('[data-reveal="left"],[data-reveal="right"]');
    const revealItems = section.querySelectorAll('[data-ri]');
    const statNums = section.querySelectorAll('.ve-stat-number[data-count]');

    let inView = false, revealed = false;
    let mouseX = 0, mouseY = 0, scrollY = window.scrollY;
    let sectionTop = 0, sectionHeight = 0;
    let rafId = null;

    function updateMetrics() {
      const r = section.getBoundingClientRect();
      sectionTop = r.top + window.scrollY;
      sectionHeight = r.height;
    }
    updateMetrics();
    window.addEventListener('resize', updateMetrics);

    // ── 1. Intersection Observer ──
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        inView = entry.isIntersecting;
        if (inView && !revealed) {
          revealed = true;
          revealAll();
        }
        if (video) {
          if (inView) video.play().catch(() => {});
          else video.pause();
        }
        if (runEffects) {
          if (inView) startParallax();
          else stopParallax();
        }
      });
    }, { rootMargin: '-6% 0px -6% 0px', threshold: [0, 0.1] });

    io.observe(section);

    function revealAll() {
      revealSides.forEach(el => el.classList.add('ve-revealed'));
      if (!runEffects) {
        revealItems.forEach(el => el.classList.add('ve-revealed'));
      } else {
        revealItems.forEach((el, i) => {
          setTimeout(() => el.classList.add('ve-revealed'), i * 110);
        });
        setTimeout(animateCounters, 600);
      }
    }

    function animateCounters() {
      statNums.forEach(el => {
        const target = parseFloat(el.dataset.count);
        if (isNaN(target)) return;
        const start = performance.now();
        const dur = 1600;
        (function tick(now) {
          const t = clamp((now - start) / dur, 0, 1);
          const eased = 1 - Math.pow(2, -10 * t);
          el.textContent = Math.floor(target * eased);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = target;
        })(start);
      });
    }

    // ── Video autoplay ──
    if (video) {
      video.muted = true;
      video.playsInline = true;
      video.loop = true;
      video.play().catch(() => {
        const play = () => { video.play().catch(() => {}); section.removeEventListener('click', play); };
        section.addEventListener('click', play);
      });
    }

    // ── Mouse Tracking (only if explicitly enabled) ──
    if (runMouse) {
      section.addEventListener('mousemove', e => {
        const r = section.getBoundingClientRect();
        mouseX = clamp((e.clientX - r.left - r.width / 2) / (r.width / 2), -1, 1);
        mouseY = clamp((e.clientY - r.top - r.height / 2) / (r.height / 2), -1, 1);
      }, { passive: true });
    }

    // ── Parallax via RAF (only while in view) ──
    function startParallax() {
      if (!rafId) rafId = requestAnimationFrame(parallaxTick);
    }
    function stopParallax() {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }
    function parallaxTick() {
      if (!inView) { rafId = null; return; }
      const vh = window.innerHeight;
      const progress = clamp((scrollY + vh - sectionTop) / (vh + sectionHeight), 0, 1);
      const offset = mapRange(progress, 0, 1, -22, 22);

      if (img) img.style.transform = `translate3d(0, ${offset}px, 0) scale(1.07)`;
      if (video) video.style.transform = `translate3d(0, ${offset * 0.7}px, 0) scale(1.06)`;
      if (watermark) watermark.style.transform = `translate3d(-5%, ${offset * 0.5}px, 0) rotate(-2deg)`;
      if (tagCard) tagCard.style.transform = `translate3d(0, ${offset * 0.4}px, 0)`;

      if (content && runMouse && (Math.abs(mouseX) + Math.abs(mouseY) > 0.01)) {
        content.style.transform = `translate3d(${mouseX * 2}px, ${mouseY * 1.5}px, 0)`;
      }

      rafId = requestAnimationFrame(parallaxTick);
    }

    if (runEffects) {
      window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopParallax();
      else if (inView && runEffects) startParallax();
    });

    // ── CTA Magnetic (only if mouse effects enabled) ──
    const btn = section.querySelector('.ve-cta-primary');
    if (btn && runMouse) {
      btn.addEventListener('mousemove', e => {
        const r = btn.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * 0.22;
        const y = (e.clientY - r.top - r.height / 2) * 0.22;
        btn.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      });
      btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
    }

    // ── Strip hover pause ──
    if (strip && stripInner) {
      strip.addEventListener('mouseenter', () => { stripInner.style.animationPlayState = 'paused'; });
      strip.addEventListener('mouseleave', () => { stripInner.style.animationPlayState = 'running'; });
    }

    // ── Cursor trail (only if mouse effects enabled) ──
    if (runMouse) {
      const trail = document.createElement('div');
      Object.assign(trail.style, {
        position: 'fixed',
        width: '180px',
        height: '180px',
        borderRadius: '50%',
        background: 'radial-gradient(circle, rgba(198,255,0,0.055) 0%, transparent 70%)',
        pointerEvents: 'none',
        transform: 'translate3d(-50%,-50%,0)',
        zIndex: '9998',
        opacity: '0',
        filter: 'blur(18px)',
        transition: 'opacity 0.3s ease',
        willChange: 'transform',
      });
      document.body.appendChild(trail);

      section.addEventListener('mouseenter', () => { trail.style.opacity = '1'; });
      section.addEventListener('mouseleave', () => { trail.style.opacity = '0'; });

      let trailRaf = null, tx = 0, ty = 0;
      document.addEventListener('mousemove', e => {
        tx = e.clientX;
        ty = e.clientY;
        if (!trailRaf) {
          trailRaf = requestAnimationFrame(() => {
            trail.style.transform = `translate3d(${tx}px, ${ty}px, 0) translate3d(-50%,-50%,0)`;
            trailRaf = null;
          });
        }
      }, { passive: true });
    }
  }

  function boot() {
    document.querySelectorAll('.vantique-editorial').forEach(initSection);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  document.addEventListener('shopify:section:load', e => {
    const s = e.target.querySelector('.vantique-editorial');
    if (s) { s._veInit = false; setTimeout(() => initSection(s), 80); }
  });
  document.addEventListener('shopify:section:unload', e => {
    const s = e.target.querySelector('.vantique-editorial');
    if (s) s._veInit = false;
  });
})();
</script>

